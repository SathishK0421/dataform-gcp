config {
    type: "table",
    name: "fact_sales_gas_alloc_poc",
    tags: ["final_fact"],
    description: ""
}

SELECT
  BPARTNER,
  BUS_AREA,
  CACONT_ACC,
  COMP_CODE,
  COSTCENTER,
  COUNTRY,
  CURRENCY,
  DATEFROM,
  DATETO,
  DIVISION,
  PSTNG_DATE,
  REGION,
  CAST(UCCNTRCNT AS DECIMAL),
  CAST(UCCONT_CNT AS DECIMAL),
  UCMOVEIN_D,
  UCMOVEOUTD,
  UCPORTION,
  UNIT,
  CAST(VAR_VR AS DECIMAL),
  ZUCBILDOC,
  ZUCCUSSEG,
  ZUCDOCINV,
  ZUCRECKEY,
  UC_DATEFRO,
  UC_DATETO,
  CALMONTH,
  NULL AS ZZ_FRACTION,
  ZUCCALEG2,
  CAST(ZGASQTY AS DECIMAL),
  CAST(ZGASLQTY AS DECIMAL),
  ZGAS_UOM,
  ZGASL_UOM,
  CAST(ZGASAMT AS DECIMAL),
  CAST(ZEDMQTY AS DECIMAL),
  CAST(ZEDMAMT AS DECIMAL)
FROM
  ${ref("uc_sales_stats_prepared")}
