config {
  type: "incremental",
  schema: "sales_cdc_poc",
  name: "ZOF1_SAI",
  tags: ["bw_migration"],
  dependencies: ["ZSEC_SALB", "ZSEC_PURB"] 
}

-- FullLoad: full table replacement on every Dataform run.

WITH

-- START ROUTINE: filters out rows where BUKRS = '4900000061'
start_routine_0FI_GL_4_S4HCLNT100 AS (
  SELECT
    BUKRS,
    LCURR,
    AUFNR,
    KOSTL,
    PRCTR,
    BELNR,
    WERKS,
    KOKRS,
    FISCVAR,
    FISCPER,
    BLDAT,
    BUDAT,
    -- HSSL,
    -- KSSK
  FROM ${ref("0FI_GL_4_BQ")}
  WHERE BUKRS <> '4900000061'
),

-- LOOKUP: replace fiscper_stub with ${ref("REAL_TABLE_NAME")}
--         once the fiscal-period calendar table name is confirmed.
fiscper_stub AS (
  SELECT
    CAST(NULL AS STRING) AS FISCVARNT,
    CAST(NULL AS DATE)   AS DATEFROM,
    CAST(NULL AS DATE)   AS DATETO,
    CAST(NULL AS STRING) AS `0FISCPER`
    from ${ref("FISCPER")}
  -- WHERE FALSE
),

mapped_ZOF1_SAI AS (
  SELECT
    s.BUKRS                                      AS COMP_CODE,
    s.LCURR                                      AS CURRENCY,
    s.AUFNR                                      AS COORDER,
    s.KOSTL                                      AS COSTCENTER,
    s.PRCTR                                      AS PROFIT_CTR,
    s.BELNR                                      AS DOC_NUM,
    s.WERKS                                      AS PLANT,
    s.KOKRS                                      AS CO_AREA,
    s.FISCVAR                                    AS `0FISCVARNT`,
    COALESCE(fp.`0FISCPER`, NULL)                AS `0FISCPER`,
    NULL                                         AS CHRT_ACCTS,  -- no source mapping defined
     s.BLDAT                AS BLDAT, -- removed parse_date funciton
     s.BUDAT                AS BUDAT  -- removed parse_date funciton
  FROM start_routine_0FI_GL_4_S4HCLNT100 s
  LEFT JOIN fiscper_stub fp
    ON s.FISCVAR = fp.FISCVARNT
),

-- END ROUTINE: replaces PROFIT_CTR value 'US10_PLR' with 'US10_nss'
end_routine_ZOF1_SAI AS (
  SELECT
    COMP_CODE,
    CURRENCY,
    COORDER,
    COSTCENTER,
    CASE
      WHEN PROFIT_CTR = 'US10_PLR' THEN 'US10_nss'
      ELSE PROFIT_CTR
    END                                          AS PROFIT_CTR,
    DOC_NUM,
    PLANT,
    CO_AREA,
    `0FISCVARNT`,
    `0FISCPER`,
    CHRT_ACCTS,
    BLDAT,
    BUDAT
  FROM mapped_ZOF1_SAI
)

SELECT
  COMP_CODE,
  CURRENCY,
  COORDER,
  COSTCENTER,
  PROFIT_CTR,
  DOC_NUM,
  PLANT,
  CO_AREA,
  `0FISCVARNT`,
  `0FISCPER`,
  CHRT_ACCTS
FROM end_routine_ZOF1_SAI