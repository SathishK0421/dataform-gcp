config {
  type: "incremental",
  schema: "sales_cdc_poc",
  name: "ZOF1_SAI",
  tags: ["bw_migration"]
}

-- FullLoad: full table replacement on every Dataform run.

WITH
  src_0fi_gl_4 AS (
    SELECT
      FISCVAR,
      BUKRS,
      FISCPER,
      KOSTL,
      AUFNR,
      LCURR,
      PRCTR,
      KOKRS,
      WERKS,
      BELNR
    FROM ${ref("0FI_GL_4")}
  ),

  -- LOOKUP: resolve 0FISCPER using a fiscal period calendar table
  -- joining on FISCVARNT and checking FISCPER between DATEFROM and DATETO
  lookup_fiscper AS (
    -- LOOKUP: verify table name for fiscal period calendar before deploying
    SELECT
      s.FISCVAR,
      s.BUKRS,
      s.FISCPER,
      s.KOSTL,
      s.AUFNR,
      s.LCURR,
      s.PRCTR,
      s.KOKRS,
      s.WERKS,
      s.BELNR,
      CAST(NULL AS STRING) AS resolved_FISCPER
    FROM ${ref("src_0fi_gl_4")} s
    -- LEFT JOIN stub: replace with verified fiscal period calendar table name before deploying
    -- LEFT JOIN ${ref("REAL_TABLE")} fp
    --   ON s.FISCVAR = fp.FISCVARNT
    --   AND s.FISCPER BETWEEN fp.DATEFROM AND fp.DATETO
  ),

  mapped AS (
    SELECT
      -- Calculated_Column: nan AS 0FISCVARNT — no source mapping defined
      NULL AS `0FISCVARNT`,
      BUKRS AS COMP_CODE,
      -- Calculated_Column: LOOKUP TABLE FISCPER using FISCVARNT, FISCPER between DATEFROM and DATETO AS 0FISCPER
      COALESCE(resolved_FISCPER, CAST(`FISCPER` AS STRING)) AS `0FISCPER`,
      -- Calculated_Column: nan AS CHRT_ACCTS — no source mapping defined
      NULL AS CHRT_ACCTS,
      KOSTL AS COSTCENTER,
      AUFNR AS COORDER,
      LCURR AS CURRENCY,
      PRCTR AS PROFIT_CTR,
      KOKRS AS CO_AREA,
      WERKS AS PLANT,
      BELNR AS DOC_NUM,
      -- Target nan columns — no source mapping defined
      NULL AS nan_1,
      NULL AS nan_2
    FROM lookup_fiscper
  )

SELECT
  `0FISCVARNT`,
  COMP_CODE,
  `0FISCPER`,
  CHRT_ACCTS,
  COSTCENTER,
  COORDER,
  CURRENCY,
  PROFIT_CTR,
  CO_AREA,
  PLANT,
  DOC_NUM,
  nan_1 AS nan,
  nan_2 AS nan
FROM mapped