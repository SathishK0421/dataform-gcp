config {
  type: "view",
  database: "sapanalytics-309913",
  schema: "sales_cdc_poc",
  name: "ZPC_TSOBJC"
}

-- ============================================================
-- Step 1 : ZTSOBJ_C  (ZTSOBJ)
-- Load Type : Merge  |  Keys : COMP_CODE, DOC_TYPE, SALESEMPLY
-- ============================================================

-- MERGE load: key fields are COMP_CODE, DOC_TYPE, SALESEMPLY

WITH
src_0IED_ZTSOBJ AS (
    SELECT
        COMP_CODE,
        DOC_TYPE,
        SALESEMPLY,
        IMODOCCATR,
        S4SOLD_TO,
        STAT_CURR,
        CPR_CREATE,
        CUST_GRP1,
        AB_ITEM,
        CRMSALORGX,
        PR_CAT_SAL,
        LOC_CURRCY,
        `0FISCVARNT`,
        `0FISCYEAR`
    FROM ${ref("ZTSOBJ")}
),

staged_ZTSOBJ_C_0IED AS (
    SELECT
        COALESCE(COMP_CODE, '')     AS COMP_CODE,
        COALESCE(DOC_TYPE, '')      AS DOC_TYPE,
        COALESCE(SALESEMPLY, '')    AS SALESEMPLY,
        IMODOCCATR                  AS IMODOCCATR,
        S4SOLD_TO                   AS S4SOLD_TO,
        STAT_CURR                   AS STAT_CURR,
        CPR_CREATE                  AS CPR_CREATE,
        CUST_GRP1                   AS CUST_GRP1,
        AB_ITEM                     AS AB_ITEM,
        CRMSALORGX                  AS CRMSALORGX,
        PR_CAT_SAL                  AS PR_CAT_SAL,
        LOC_CURRCY                  AS LOC_CURRCY,
        `0FISCVARNT`                AS `0FISCVARNT`,
        `0FISCYEAR`                 AS `0FISCYEAR`,
        100.0                       AS AMNT,
        ROW_NUMBER() OVER (
            PARTITION BY COALESCE(COMP_CODE, ''), COALESCE(DOC_TYPE, ''), COALESCE(SALESEMPLY, '')
            ORDER BY (SELECT NULL)
        ) AS _row_num
    FROM src_0IED_ZTSOBJ
    QUALIFY _row_num = 1
)

SELECT
    COMP_CODE,
    DOC_TYPE,
    SALESEMPLY,
    IMODOCCATR,
    S4SOLD_TO,
    STAT_CURR,
    CPR_CREATE,
    CUST_GRP1,
    AB_ITEM,
    CRMSALORGX,
    PR_CAT_SAL,
    LOC_CURRCY,
    `0FISCVARNT`,
    `0FISCYEAR`
FROM staged_ZTSOBJ_C_0IED;

-- ============================================================
-- Step 1 : ZSA_ITM  (ZNS_ITEM)
-- Load Type : FullLoad  |  Keys : IMODOCCATR
-- ============================================================

WITH

-- START ROUTINE: Filters out rows where MATNR = 'TG11'
start_routine_ZNS_ITEM AS (
  SELECT
    VBELN,
    VOLEH,
    VOLUM,
    VDATU,
    MEINS,
    KZWI1,
    KZWI3,
    KZWI2,
    KPEIN,
    MWSBP,
    KMEIN,
    MATWA,
    PKUNRG,
    PSTYV,
    WAERK,
    PKUNWE,
    BUKRS,
    MATKL,
    NETPR,
    HWAER,
    NTGEW,
    GEWEI,
    UVFAK,
    UVVLK,
    MATNR,
    STWAE,
    ERZET,
    ERDAT,
    LSMENG,
    WERKS,
    NETWR
  FROM ${ref("ZNS_ITEM")}
  WHERE MATNR <> 'TG11'
),

-- FISCAL YEAR lookup: uses FISCPER lookup table with FISCVARNT, PERIV between DATEFROM and DATETO
-- 0FISCVARNT: SOURCE & TARGET FIELD SAME, NO LOGIC REQUIRED
-- 0FISCYEAR: LOOKUP TABLE FISCPER using FISCVARNT, PERIV between DATEFROM and DATETO
fiscper_lookup AS (
  -- LOOKUP: verify table name for FISCPER before deploying
  -- SELECT
  --   FISCVARNT,
  --   PERIV,
  --   DATEFROM,
  --   DATETO,
  --   FISCYEAR AS `0FISCYEAR`
  -- FROM `FISCPER`
  SELECT
    CAST(NULL AS STRING) AS FISCVARNT,
    CAST(NULL AS STRING) AS PERIV,
    CAST(NULL AS DATE)   AS DATEFROM,
    CAST(NULL AS DATE)   AS DATETO,
    CAST(NULL AS STRING) AS `0FISCYEAR`
  WHERE FALSE
),

src_0ANX2_ZNS_ITEM AS (
  SELECT
    s.VBELN,
    s.VOLEH,
    s.VOLUM,
    s.VDATU,
    s.MEINS,
    s.KZWI1,
    s.KZWI3,
    s.KZWI2,
    s.KPEIN,
    s.MWSBP,
    s.KMEIN,
    s.MATWA,
    s.PKUNRG,
    s.PSTYV,
    s.WAERK,
    s.PKUNWE,
    s.BUKRS,
    s.MATKL,
    s.NETPR,
    s.HWAER,
    s.NTGEW,
    s.GEWEI,
    s.UVFAK,
    s.UVVLK,
    s.MATNR,
    s.STWAE,
    s.ERZET,
    s.ERDAT,
    s.LSMENG,
    s.WERKS,
    s.NETWR,
    -- TODO: correct source column for 0FISCVARNT is not available; VBELN is a document number and must not be used here
    NULL AS `0FISCVARNT`,
    -- 0FISCYEAR: lookup via FISCPER table using FISCVARNT/PERIV between DATEFROM/DATETO
    f.`0FISCYEAR`
  FROM start_routine_ZNS_ITEM s
  LEFT JOIN fiscper_lookup f
    ON s.VBELN = f.FISCVARNT
    AND PARSE_DATE('%Y%m%d', s.ERDAT) BETWEEN f.DATEFROM AND f.DATETO
),

staged_ZSA_ITM_0ANX2 AS (
  SELECT
    -- VBELN -> IMODOCCATR (key field, must not be NULL)
    COALESCE(VBELN, '')                                        AS IMODOCCATR,
    -- VOLEH -> VOLUMEUNIT
    VOLEH                                                      AS VOLUMEUNIT,
    -- VOLUM -> VOLUME
    CAST(VOLUM AS NUMERIC)                                     AS VOLUME,
    -- VDATU -> UPD_DATE (DATS 8-char YYYYMMDD -> DATE)
    PARSE_DATE('%Y%m%d', VDATU)                                AS UPD_DATE,
    -- MEINS -> BASE_UOM
    MEINS                                                      AS BASE_UOM,
    -- KZWI1 -> SUBTOT_OC1
    CAST(KZWI1 AS NUMERIC(18,2))                               AS SUBTOT_OC1,
    -- KZWI3 -> SUBTOT_OC3
    CAST(KZWI3 AS NUMERIC)                                     AS SUBTOT_OC3,
    -- KZWI2 -> SUBTOT_OC2
    CAST(KZWI2 AS NUMERIC(18,3))                               AS SUBTOT_OC2,
    -- KPEIN -> COND_PR_UN
    CAST(KPEIN AS NUMERIC)                                     AS COND_PR_UN,
    -- MWSBP -> TAX_VALUE
    CAST(MWSBP AS NUMERIC(18,2))                               AS TAX_VALUE,
    -- KMEIN -> UNIT
    KMEIN                                                      AS UNIT,
    -- MATWA -> MATENTERD
    MATWA                                                      AS MATENTERD,
    -- PKUNRG -> PAYER
    PKUNRG                                                     AS PAYER,
    -- PSTYV -> ITM_CAT
    PSTYV                                                      AS ITM_CAT,
    -- WAERK -> DOC_CURRCY (WAERS currency key -> STRING)
    WAERK                                                      AS DOC_CURRCY,
    -- PKUNWE -> S4SHIP_TO
    PKUNWE                                                     AS S4SHIP_TO,
    -- BUKRS -> COMP_CODE
    BUKRS                                                      AS COMP_CODE,
    -- MATKL -> MATL_GROUP
    MATKL                                                      AS MATL_GROUP,
    -- NETPR -> NETPRICE
    CAST(NETPR AS NUMERIC)                                     AS NETPRICE,
    -- HWAER -> LOC_CURRCY (WAERS currency key -> STRING)
    HWAER                                                      AS LOC_CURRCY,
    -- NTGEW -> NET_WGT_DL
    CAST(NTGEW AS NUMERIC(18,3))                               AS NET_WGT_DL,
    -- GEWEI -> UNIT_OF_WT
    GEWEI                                                      AS UNIT_OF_WT,
    -- UVFAK -> AB_ITEM
    UVFAK                                                      AS AB_ITEM,
    -- UVVLK -> DELIV_ITEM
    UVVLK                                                      AS DELIV_ITEM,
    -- MATNR -> BIC_ZMATEIAL1
    MATNR                                                      AS BIC_ZMATEIAL1,
    -- STWAE -> STAT_CURR (WAERS currency key -> STRING)
    STWAE                                                      AS STAT_CURR,
    -- ERZET -> TIME (TIMS 6-char HHMMSS -> TIME)
    PARSE_TIME('%H%M%S', ERZET)                                AS TIME
),

-- END ROUTINE: After mapping, if PLANT = '1710' then set PLANT = '1720'
end_routine_ZSA_ITM AS (
  SELECT
    IMODOCCATR,
    VOLUMEUNIT,
    VOLUME,
    UPD_DATE,
    BASE_UOM,
    SUBTOT_OC1,
    SUBTOT_OC3,
    SUBTOT_OC2,
    COND_PR_UN,
    TAX_VALUE,
    UNIT,
    MATENTERD,
    PAYER,
    ITM_CAT,
    DOC_CURRCY,
    S4SHIP_TO,
    COMP_CODE,
    MATL_GROUP,
    NETPRICE,
    LOC_CURRCY,
    NET_WGT_DL,
    UNIT_OF_WT,
    AB_ITEM,
    DELIV_ITEM,
    BIC_ZMATEIAL1,
    STAT_CURR,
    TIME,
    CR_ON_I,
    REQDEKIQUANTY,
    -- END ROUTINE: if PLANT = '1710' then PLANT = '1720'
    CASE WHEN PLANT = '1710' THEN '1720' ELSE PLANT END        AS PLANT,
    BASIC_MATL,
    -- PLANTCAT derived from WERKS -> also apply end routine plant logic
    CASE WHEN PLANTCAT = '1710' THEN '1720' ELSE PLANTCAT END  AS PLANTCAT,
    NETVALUE_2 AS NETVALUE
  FROM staged_ZSA_ITM_0ANX2
)

SELECT
  IMODOCCATR,
  VOLUMEUNIT,
  VOLUME,
  UPD_DATE,
  BASE_UOM,
  SUBTOT_OC1,
  SUBTOT_OC3,
  SUBTOT_OC2,
  COND_PR_UN,
  TAX_VALUE,
  UNIT,
  MATENTERD,
  PAYER,
  ITM_CAT,
  DOC_CURRCY,
  S4SHIP_TO,
  COMP_CODE,
  MATL_GROUP,
  NETPRICE,
  LOC_CURRCY,
  NET_WGT_DL,
  UNIT_OF_WT,
  AB_ITEM,
  DELIV_ITEM,
  BIC_ZMATEIAL1,
  STAT_CURR,
  TIME,
  CR_ON_I,
  REQDEKIQUANTY,
  PLANT,
  BASIC_MATL,
  PLANTCAT
FROM end_routine_ZSA_ITM;

-- ============================================================
-- Step 1 : ZSALEHDR  (IMO_D_SD10)
-- Load Type : Merge  |  Keys : DOC_NUMBER
-- ============================================================
-- MERGE load: key fields are DOC_NUMBER

WITH

-- START ROUTINE: filters out rows where GN_CUSTOM = '2CUS10100001' AND SALESEMPLY = '00000024'
start_routine_IMO_D_SD10 AS (
  SELECT
    DOC_NUMBER,
    COMP_CODE,
    QUOT_FROM,
    QUOT_TO,
    SALESEMPLY,
    SOLD_TO,
    LOC_CURRCY,
    STAT_CURR,
    DISTR_CHAN,
    SALES_OFF,
    SALES_GRP,
    SALESORG,
    GN_R3_SSY,
    IMODOCCAT,
    `0CALDAY`,
    RECORDMODE,
    SO_H_CNT
  FROM ${ref("IMO_D_SD10")}
  WHERE NOT (
    -- Pre-filter: exclude rows WHERE GN_CUSTOM = '2CUS10100001' AND SALESEMPLY = '00000024'
    -- GN_CUSTOM is derived as:
    --   IF SOLD_TO IS NULL OR SOLD_TO = '' THEN ''
    --   ELSE IF SOLD_TO contains only digits (leading zeros stripped equals its integer representation) THEN CONCAT(GN_R3_SSY, ' 2CUS', LTRIM(SOLD_TO, '0'))
    --   ELSE CONCAT(GN_R3_SSY, ' 2CUS', SOLD_TO)
    (
      CASE
        WHEN (SOLD_TO IS NULL OR SOLD_TO = '' OR SOLD_TO = '0') THEN ''
        WHEN REGEXP_REPLACE(SOLD_TO, r'^0+', '') = CAST(SAFE_CAST(SOLD_TO AS INT64) AS STRING) THEN
          CONCAT(GN_R3_SSY, ' 2CUS', REGEXP_REPLACE(SOLD_TO, r'^0+', ''))
        ELSE
          CONCAT(GN_R3_SSY, ' 2CUS', SOLD_TO)
      END = '2CUS10100001'
      AND SALESEMPLY = '00000024'
    )
  )
),

-- LOOKUP TABLE FISCPER using FISCVARNT, 0CALDAY between DATEFROM and DATETO
fiscper_lookup AS (
  SELECT
    FISCVARNT,
    `0FISCPER`,
    `0FISCYEAR`,
    DATEFROM,
    DATETO
  FROM ${ref("FISCPER")}
),

-- Field-level mappings CTE
staged_ZSALEHDR_0NFO AS (
  SELECT
    -- Key field: must not be NULL
    COALESCE(s.DOC_NUMBER, '') AS DOC_NUMBER,
    s.COMP_CODE AS COMP_CODE,
    s.QUOT_FROM AS QUOT_FROM,
    s.QUOT_TO AS QUOT_TO,
    s.SALESEMPLY AS SALESEMPLY,
    s.SOLD_TO AS SOLD_TO,
    s.LOC_CURRCY AS LOC_CURRCY,
    s.STAT_CURR AS STAT_CURR,
    s.DISTR_CHAN AS DISTR_CHAN,
    s.SALES_OFF AS SALES_OFF,
    s.SALES_GRP AS SALES_GRP,
    s.SALESORG AS SALESORG,
    s.GN_R3_SSY AS GN_R3_SSY,
    s.IMODOCCAT AS IMODOCCAT,
    PARSE_DATE('%Y%m%d', s.`0CALDAY`) AS `0CALDAY`,
    -- BIC_ZIOC_GRP: mapped from COMP_CODE (Source index 15 -> Target BIC_ZIOC_GRP)
    s.COMP_CODE AS BIC_ZIOC_GRP,
    -- FISCVARNT: mapped from COMP_CODE (Source index 16 -> Target FISCVARNT)
    s.COMP_CODE AS FISCVARNT,

    -- Calculated columns (field-level rules)

    -- LOOKUP: FISCPER using FISCVARNT, 0CALDAY between DATEFROM and DATETO AS 0FISCPER
    fp.`0FISCPER` AS `0FISCPER`,

    -- LOOKUP: FISCPER using FISCVARNT, 0CALDAY between DATEFROM and DATETO AS 0FISCYEAR
    fp.`0FISCYEAR` AS `0FISCYEAR`,

    -- CONSTANT: 15.000 AS BIC_ZSO_H_CNT
    CAST(15.000 AS NUMERIC) AS BIC_ZSO_H_CNT_2,

    -- IF ( RECORDMODE = "R" , 0 , IF ( IMODOCCAT = "H" OR IMODOCCAT = "K" , NEGATIVE ( SO_H_CNT ) , SO_H_CNT ) ) AS SO_H_CNT
    CASE
      WHEN s.RECORDMODE = 'R' THEN 0
      WHEN s.IMODOCCAT = 'H' OR s.IMODOCCAT = 'K' THEN -1 * s.SO_H_CNT
      ELSE s.SO_H_CNT
    END AS SO_H_CNT_2,

    -- ABS ( 10 / 2 ) AS BIC_ZIOKF_T1
    ABS(SAFE_DIVIDE(10, 2)) AS BIC_ZIOKF_T1_2,

    -- IF ( IMODOCCAT = "H" OR IMODOCCAT = "K" , "C" , "D" ) AS DEB_CRED
    CASE
      WHEN s.IMODOCCAT = 'H' OR s.IMODOCCAT = 'K' THEN 'C'
      ELSE 'D'
    END AS DEB_CRED_2,

    -- IF ( IS_INITIAL ( SOLD_TO ) , "" , IF ( IS_INTEGER ( SOLD_TO ) , GN_R3_SSY & " 2CUS" & LTRIM ( SOLD_TO , 0 ) , GN_R3_SSY & " 2CUS" & SOLD_TO ) ) AS GN_CUSTOM
    CASE
      WHEN (s.SOLD_TO IS NULL OR s.SOLD_TO = '' OR s.SOLD_TO = '0') THEN ''
      WHEN SAFE_CAST(s.SOLD_TO AS INT64) IS NOT NULL THEN
        CONCAT(s.GN_R3_SSY, ' 2CUS', REGEXP_REPLACE(s.SOLD_TO, r'^0+', ''))
      ELSE
        CONCAT(s.GN_R3_SSY, ' 2CUS', s.SOLD_TO)
    END AS GN_CUSTOM_2,

    -- IF ( RECORDMODE = "R" , "X" , "" ) AS HEADER_DEL
    CASE
      WHEN s.RECORDMODE = 'R' THEN 'X'
      ELSE ''
    END AS HEADER_DEL_2,

    -- IF ( IMODOCCAT = "B" , "Q" , "O" ) AS DOC_CLASS
    CASE
      WHEN s.IMODOCCAT = 'B' THEN 'Q'
      ELSE 'O'
    END AS DOC_CLASS_2,

    -- IF ( RECORDMODE = "R" , 1 , 0 ) AS DLT_H_CNT
    CASE
      WHEN s.RECORDMODE = 'R' THEN 1
      ELSE 0
    END AS DLT_H_CNT_2,

    -- Pass through RECORDMODE for END ROUTINE usage
    s.RECORDMODE AS RECORDMODE,

    ROW_NUMBER() OVER (
      PARTITION BY COALESCE(s.DOC_NUMBER, '')
      ORDER BY (SELECT NULL)
    ) AS _row_num

  FROM start_routine_IMO_D_SD10 s
  LEFT JOIN fiscper_lookup fp
    ON s.COMP_CODE = fp.FISCVARNT
    AND PARSE_DATE('%Y%m%d', s.`0CALDAY`) BETWEEN fp.DATEFROM AND fp.DATETO
  QUALIFY _row_num = 1
),

-- END ROUTINE: sets UPD_DATE = CURRENT_DATE for all rows
end_routine_ZSALEHDR AS (
  SELECT
    DOC_NUMBER,
    COMP_CODE,
    QUOT_FROM,
    QUOT_TO,
    SALESEMPLY,
    SOLD_TO,
    LOC_CURRCY,
    STAT_CURR,
    DISTR_CHAN,
    SALES_OFF,
    SALES_GRP,
    SALESORG,
    GN_R3_SSY,
    IMODOCCAT,
    `0CALDAY`,
    BIC_ZIOC_GRP,
    FISCVARNT,
    `0FISCPER`,
    `0FISCYEAR`,
    BIC_ZSO_H_CNT,
    BIC_ZSO_H_CNT_2,
    SO_H_CNT,
    SO_H_CNT_2,
    BIC_ZIOKF_T1,
    BIC_ZIOKF_T1_2,
    DEB_CRED,
    DEB_CRED_2,
    GN_CUSTOM,
    GN_CUSTOM_2,
    HEADER_DEL,
    HEADER_DEL_2,
    DOC_CLASS,
    DLT_H_CNT,
    -- END ROUTINE: <RESULT_FIELDS>-UPD_DATE = SY-DATUM
    CURRENT_DATE AS UPD_DATE
  FROM staged_ZSALEHDR_0NFO
)

SELECT
  DOC_NUMBER,
  COMP_CODE,
  QUOT_FROM,
  QUOT_TO,
  SALESEMPLY,
  SOLD_TO,
  LOC_CURRCY,
  STAT_CURR,
  DISTR_CHAN,
  SALES_OFF,
  SALES_GRP,
  SALESORG,
  GN_R3_SSY,
  IMODOCCAT,
  `0CALDAY`,
  BIC_ZIOC_GRP,
  FISCVARNT
FROM end_routine_ZSALEHDR;

-- ============================================================
-- Step 1 : ZSEC_SALA  (ZTSOBJ_C)
-- Load Type : Merge  |  Keys : COMP_CODE, DOC_TYPE, SALESEMPLY
-- ============================================================
-- MERGE load: key fields are COMP_CODE, DOC_TYPE, SALESEMPLY

WITH
  src_0O5H_ZTSOBJ_C AS (
    SELECT
      COMP_CODE,
      DOC_TYPE,
      SALESEMPLY,
      AMNT,
      STAT_CURR,
      IMODOCCATR,
      S4SOLD_TO,
      CPR_CREATE,
      LOC_CURRCY,
      CUST_GRP1,
      CRMSALORGX,
      PR_CAT_SAL,
      AB_ITEM,
      `0FISCVARNT`,
      `0FISCYEAR`
    FROM ${ref("ZTSOBJ_C")}
  ),

  staged_ZSEC_SALA_0O5H AS (
    SELECT
      COALESCE(COMP_CODE, '')    AS COMP_CODE,
      COALESCE(DOC_TYPE, '')     AS DOC_TYPE,
      COALESCE(SALESEMPLY, '')   AS SALESEMPLY,
      AMNT                       AS AMNT,
      STAT_CURR                  AS STAT_CURR,
      IMODOCCATR                 AS IMODOCCATR,
      S4SOLD_TO                  AS S4SOLD_TO,
      CPR_CREATE                 AS CPR_CREATE,
      LOC_CURRCY                 AS LOC_CURRCY,
      CUST_GRP1                  AS CUST_GRP1,
      CRMSALORGX                 AS CRMSALORGX,
      PR_CAT_SAL                 AS PR_CAT_SAL,
      AB_ITEM                    AS AB_ITEM,
      `0FISCVARNT`               AS `0FISCVARNT`,
      `0FISCYEAR`                AS `0FISCYEAR`,
      ROW_NUMBER() OVER (
          PARTITION BY COALESCE(COMP_CODE, ''), COALESCE(DOC_TYPE, ''), COALESCE(SALESEMPLY, '')
          ORDER BY (SELECT NULL)
      ) AS _row_num
    FROM src_0O5H_ZTSOBJ_C
    QUALIFY _row_num = 1
  )

SELECT
  COMP_CODE,
  DOC_TYPE,
  SALESEMPLY,
  AMNT,
  STAT_CURR,
  IMODOCCATR,
  S4SOLD_TO,
  CPR_CREATE,
  LOC_CURRCY,
  CUST_GRP1,
  CRMSALORGX,
  PR_CAT_SAL,
  AB_ITEM,
  `0FISCVARNT`,
  `0FISCYEAR`
FROM staged_ZSEC_SALA_0O5H;

-- ============================================================
-- Step 1 : ZOF1_SAI  (0FI_GL_4_S4HCLNT100)
-- Load Type : FullLoad  |  Keys : DOC_NUM
-- ============================================================

WITH

/*
  START ROUTINE:
  ABAP logic: DELETE &SP& where BUKRS eq '4900000061'
  Translated: Filter out rows where BUKRS = '4900000061'
*/
start_routine_0FI_GL_4_S4HCLNT100 AS (
  SELECT
    BUKRS,
    LCURR,
    AUFNR,
    KOSTL,
    PRCTR,
    BELNR,
    WERKS,
    KOKRS,
    FISCVAR
  FROM ${ref("0FI_GL_4_S4HCLNT100")}
  WHERE BUKRS <> '4900000061'
),

/*
  LOOKUP: 0FISCPER via FISCVARNT table using FISCVARNT, FISCPER between DATEFROM and DATETO
  Since we do not have an explicit lookup table name beyond the field hint "FISCPER using FISCVARNT",
  we assume a reference table named FISCPER_LOOKUP with columns FISCVARNT, FISCPER, DATEFROM, DATETO.
  This join resolves 0FISCPER from the source FISCVAR (mapped as 0FISCVARNT) and a date range lookup.
*/
fiscper_lookup AS (
  SELECT
    FISCVARNT,
    FISCPER,
    DATEFROM,
    DATETO
  FROM `FISCPER_LOOKUP`
),

src_0DHZ_0FI_GL_4_S4HCLNT100 AS (
  SELECT
    s.BUKRS,
    s.LCURR,
    s.AUFNR,
    s.KOSTL,
    s.PRCTR,
    s.BELNR,
    s.WERKS,
    s.KOKRS,
    s.FISCVAR,
    -- TODO: no explicit reference date column is available from the source mapping to apply
    -- the date range condition (AND <date_col> BETWEEN fl.DATEFROM AND fl.DATETO).
    -- Emitting NULL until the correct date column is identified.
    NULL AS resolved_FISCPER
  FROM start_routine_0FI_GL_4_S4HCLNT100 AS s
),

staged_ZOF1_SAI_0DHZ AS (
  SELECT
    BUKRS           AS COMP_CODE,
    LCURR           AS CURRENCY,
    AUFNR           AS COORDER,
    KOSTL           AS COSTCENTER,
    PRCTR           AS PROFIT_CTR,
    BELNR           AS DOC_NUM,
    WERKS           AS PLANT,
    KOKRS           AS CO_AREA,
    FISCVAR         AS `0FISCVARNT`,
    resolved_FISCPER AS `0FISCPER`,
    NULL            AS CHRT_ACCTS,  -- no source mapping defined
    ROW_NUMBER() OVER (
        PARTITION BY BELNR
        ORDER BY (SELECT NULL)
    ) AS _row_num
  FROM src_0DHZ_0FI_GL_4_S4HCLNT100
  QUALIFY _row_num = 1
),

/*
  END ROUTINE:
  ABAP logic:
    LOOP AT &RP& ASSIGNING <result_fields>.
      if <result_fields>-profit_ctr = 'US10_PLR'.
        <result_fields>-profit_ctr = 'US10_nss'.
      endif.
    ENDLOOP.
  Translated: Replace PROFIT_CTR value 'US10_PLR' with 'US10_nss' for all matching rows.
  END ROUTINE operates on TARGET column names.
*/
end_routine_ZOF1_SAI AS (
  SELECT
    COMP_CODE,
    CURRENCY,
    COORDER,
    COSTCENTER,
    CASE
      WHEN PROFIT_CTR = 'US10_PLR' THEN 'US10_nss'
      ELSE PROFIT_CTR
    END             AS PROFIT_CTR,
    DOC_NUM,
    PLANT,
    CO_AREA,
    `0FISCVARNT`,
    `0FISCPER`,
    CHRT_ACCTS
  FROM staged_ZOF1_SAI_0DHZ
)

SELECT
  COMP_CODE,
  CURRENCY,
  COORDER,
  COSTCENTER,
  PROFIT_CTR,
  DOC_NUM,
  PLANT,
  CO_AREA,
  `0FISCVARNT`,
  `0FISCPER`,
  CHRT_ACCTS
FROM end_routine_ZOF1_SAI;

