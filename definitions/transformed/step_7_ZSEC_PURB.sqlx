-- ============================================================
-- Dataform SQLX
-- Step 7 | Transformation ID: 04E7DMFG5LF664HGEQ3X5LPVJVXXPHEC
-- Operation  : Merge
-- Source     : ZSEC_PURA
-- Target     : ZSEC_PURB
-- Merge keys : COMP_CODE, SALESEMPLY
-- Calculated : 'CBG0' AS DOC_TYPE (hardcoded literal)
-- ============================================================

config {
  type: "incremental",
  schema: "your_dataset",
  name: "ZSEC_PURB",
  description: "Step 7 – Merge ZSEC_PURA into ZSEC_PURB with DOC_TYPE forced to CBG0",
  tags: ["ZPC_TSOBJC", "step_7", "merge"],
  uniqueKey: ["COMP_CODE", "SALESEMPLY"]
}

SELECT
    COMP_CODE,
    SALESEMPLY,
    IMODOCCATR,
    AMNT,
    STAT_CURR,
    S4SOLD_TO,
    CUST_GRP1,
    CPR_CREATE,
    LOC_CURRCY,
    AB_ITEM,
    CRMSALORGX,
    PR_CAT_SAL,
    `0FISCYEAR`,
    `0FISCVARNT`,
    'CBG0' AS DOC_TYPE  -- Calculated column: hardcoded literal

FROM ${ref("ZSEC_PURA")}

${ when(incremental(),
    `WHERE COMP_CODE || SALESEMPLY NOT IN (
        SELECT COMP_CODE || SALESEMPLY
        FROM ${self()}
    )`
) }
