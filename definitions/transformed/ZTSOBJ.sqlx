config {
  type: "incremental",
  schema: "sales_cdc_poc",
  name: "ZTSOBJ",
  uniqueKey: ["COMP_CODE", "DOC_TYPE", "SALESEMPLY"],
  assertions: {
    nonNull: ["COMP_CODE", "DOC_TYPE", "SALESEMPLY"]
  },
  tags: ["bw_migration"]
}

-- INCREMENTAL NOTE: no timestamp column available for delta filter;
-- full reload on every run. Add a WHERE clause when a delta key exists.
-- ZTSOBJ is listed in no_timestamp_tables; when(incremental()) is intentionally omitted.

WITH

src_ZDS_HDR1 AS (
  SELECT
    COMP_CODE,
    DOC_TYPE,
    SALESEMPLY,
    IMODOCCATR,
    S4SOLD_TO,
    STAT_CURR,
    CPR_CREATE,
    CUST_GRP1,
    AB_ITEM,
    CRMSALORGX,
    PR_CAT_SAL,
    LOC_CURRCY,
    `0FISCVARNT`,
    `0FISCYEAR`
  FROM ${ref("ZDS_HDR1")}
),

-- START ROUTINE: translated from ABAP function module (CODEID: 7SNDWZ3CAKOMBATNBMXPP69MN)
-- Logic:
--   1. DELETE row if COMP_CODE IS INITIAL OR FISCYEAR IS INITIAL (mandatory field validation)
--   2. If STAT_CURR IS INITIAL, default it to LOC_CURRCY
--   3. CALL FUNCTION 'ZBW_SD_VALIDATE_START' — external FM; cannot be replicated in SQL.
--      Rows that would fail validation (lv_valid <> 'X') are excluded via a placeholder filter.
--      NOTE: Replace the stub 'TRUE' condition below with the real validation logic
--      once ZBW_SD_VALIDATE_START behaviour is confirmed.
start_routine_ZTSOBJ AS (
  SELECT
    COMP_CODE,
    DOC_TYPE,
    -- NUMC field: must remain STRING, never cast to INT64
    SALESEMPLY,
    IMODOCCATR,
    S4SOLD_TO,
    -- WAERS field: always STRING
    -- Default STAT_CURR to LOC_CURRCY if STAT_CURR IS INITIAL
    CASE
      WHEN (STAT_CURR IS NULL OR STAT_CURR = '')
        THEN LOC_CURRCY
      ELSE STAT_CURR
    END AS STAT_CURR,
    CPR_CREATE,
    CUST_GRP1,
    AB_ITEM,
    CRMSALORGX,
    PR_CAT_SAL,
    -- WAERS field: always STRING
    LOC_CURRCY,
    `0FISCVARNT`,
    `0FISCYEAR`
  FROM src_ZDS_HDR1
  WHERE
    -- Mandatory field validation: delete rows where COMP_CODE IS INITIAL OR FISCYEAR IS INITIAL
    (COMP_CODE IS NOT NULL AND COMP_CODE <> '')
    AND (`0FISCYEAR` IS NOT NULL AND `0FISCYEAR` <> '')
    -- ZBW_SD_VALIDATE_START: external FM validation cannot be replicated in SQL.
    -- TODO: replace TRUE with real validation predicate for ZBW_SD_VALIDATE_START
    -- when i_comp_code / i_fiscyear validation logic is available.
    AND TRUE
),

staged_ZTSOBJ AS (
  SELECT
    COMP_CODE                              AS COMP_CODE,
    DOC_TYPE                               AS DOC_TYPE,
    -- NUMC: zero-padded string, remains STRING
    COALESCE(SALESEMPLY, '')               AS SALESEMPLY,
    IMODOCCATR                             AS IMODOCCATR,
    S4SOLD_TO                              AS S4SOLD_TO,
    -- WAERS: always STRING
    COALESCE(STAT_CURR, '')                AS STAT_CURR,
    CPR_CREATE                             AS CPR_CREATE,
    CUST_GRP1                              AS CUST_GRP1,
    AB_ITEM                                AS AB_ITEM,
    CRMSALORGX                             AS CRMSALORGX,
    PR_CAT_SAL                             AS PR_CAT_SAL,
    -- WAERS: always STRING
    COALESCE(LOC_CURRCY, '')               AS LOC_CURRCY,
    -- FISCVARNT: keep as STRING
    COALESCE(`0FISCVARNT`, '')             AS `0FISCVARNT`,
    -- FISCYEAR: keep as STRING
    COALESCE(`0FISCYEAR`, '')              AS `0FISCYEAR`
  FROM start_routine_ZTSOBJ
)

SELECT
  COMP_CODE,
  DOC_TYPE,
  SALESEMPLY,
  IMODOCCATR,
  S4SOLD_TO,
  STAT_CURR,
  CPR_CREATE,
  CUST_GRP1,
  AB_ITEM,
  CRMSALORGX,
  PR_CAT_SAL,
  LOC_CURRCY,
  `0FISCVARNT`,
  `0FISCYEAR`
FROM staged_ZTSOBJ