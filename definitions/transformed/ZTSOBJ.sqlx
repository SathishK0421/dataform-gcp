config {
  type: "incremental",
  schema: "sales_cdc_poc",
  name: "ZSA_ITM",
  tags: ["bw_migration"]
}

-- FullLoad: full table replacement on every Dataform run.

-- LOOKUP: replace fiscper_stub with ${ref("REAL_TABLE_NAME")}
--         once the fiscal-period calendar table name is confirmed.

WITH

fiscper_stub AS (
  SELECT
    CAST(NULL AS STRING) AS FISCVARNT,
    CAST(NULL AS DATE)   AS DATEFROM,
    CAST(NULL AS DATE)   AS DATETO,
    CAST(NULL AS STRING) AS `0FISCPER`,
    CAST(NULL AS STRING) AS `0FISCYEAR`
  FROM UNNEST([]) AS empty
),

-- START ROUTINE: DELETE rows WHERE MATNR = 'TG11' (translated from ABAP start routine)
start_routine_ZNS_ITEM AS (
  SELECT
    VBELN,
    VOLEH,
    VOLUM,
    VDATU,
    MEINS,
    KZWI1,
    KZWI3,
    KZWI2,
    KPEIN,
    MWSBP,
    KMEIN,
    MATWA,
    PKUNRG,
    PSTYV,
    WAERK,
    PKUNWE,
    BUKRS,
    MATKL,
    NETPR,
    HWAER,
    NTGEW,
    GEWEI,
    UVFAK,
    UVVLK,
    MATNR,
    STWAE,
    ERZET,
    ERDAT,
    LSMENG,
    WERKS
  FROM ${ref("ZNS_ITEM")}
  WHERE MATNR <> 'TG11'
),

-- Field-level mapping CTE with fiscal period lookup stub
src_mapped AS (
  SELECT
    s.VBELN                          AS IMODOCCATR,
    s.VOLEH                          AS VOLUMEUNIT,
    s.VOLUM                          AS VOLUME,
    PARSE_DATE('%Y%m%d', s.VDATU)    AS UPD_DATE,
    s.MEINS                          AS BASE_UOM,
    s.KZWI1                          AS SUBTOT_OC1,
    s.KZWI3                          AS SUBTOT_OC3,
    s.KZWI2                          AS SUBTOT_OC2,
    s.KPEIN                          AS COND_PR_UN,
    s.MWSBP                          AS TAX_VALUE,
    s.KMEIN                          AS UNIT,
    s.MATWA                          AS MATENTERD,
    s.PKUNRG                         AS PAYER,
    s.PSTYV                          AS ITM_CAT,
    s.WAERK                          AS DOC_CURRCY,
    s.PKUNWE                         AS S4SHIP_TO,
    s.BUKRS                          AS COMP_CODE,
    s.MATKL                          AS MATL_GROUP,
    s.NETPR                          AS NETPRICE,
    s.HWAER                          AS LOC_CURRCY,
    s.NTGEW                          AS NET_WGT_DL,
    s.GEWEI                          AS UNIT_OF_WT,
    s.UVFAK                          AS AB_ITEM,
    s.UVVLK                          AS DELIV_ITEM,
    s.MATNR                          AS BIC_ZMATEIAL1,
    s.STWAE                          AS STAT_CURR,
    s.ERZET                          AS TIME,
    PARSE_DATE('%Y%m%d', s.ERDAT)    AS CR_ON_I,
    s.LSMENG                         AS REQDEKIQUANTY,
    s.WERKS                          AS PLANT,
    s.MATNR                          AS BASIC_MATL,
    s.WERKS                          AS PLANTCAT,
    -- TODO: STWAE is a currency key (WAERS), not a fiscal variant; replace with correct FISCVARNT source column when available
    CAST(NULL AS STRING)             AS `0FISCVARNT`,
    -- LOOKUP TABLE FISCPER using FISCVARNT, PERIV between DATEFROM and DATETO AS 0FISCYEAR
    fp.`0FISCYEAR`                   AS `0FISCYEAR`,
    fp.`0FISCPER`                    AS `0FISCPER`,
    -- NETVALUE: no expression defined in spec
    NULL                             AS NETVALUE
  FROM start_routine_ZNS_ITEM s
  LEFT JOIN fiscper_stub fp
    ON CAST(NULL AS STRING) = fp.FISCVARNT
),

-- END ROUTINE: if PLANT = '1710' then set PLANT = '1720' (operates on target column names)
end_routine_ZSA_ITM AS (
  SELECT
    IMODOCCATR,
    VOLUMEUNIT,
    VOLUME,
    UPD_DATE,
    BASE_UOM,
    SUBTOT_OC1,
    SUBTOT_OC3,
    SUBTOT_OC2,
    COND_PR_UN,
    TAX_VALUE,
    UNIT,
    MATENTERD,
    PAYER,
    ITM_CAT,
    DOC_CURRCY,
    S4SHIP_TO,
    COMP_CODE,
    MATL_GROUP,
    NETPRICE,
    LOC_CURRCY,
    NET_WGT_DL,
    UNIT_OF_WT,
    AB_ITEM,
    DELIV_ITEM,
    BIC_ZMATEIAL1,
    STAT_CURR,
    TIME,
    CR_ON_I,
    REQDEKIQUANTY,
    CASE
      WHEN PLANT = '1710' THEN '1720'
      ELSE PLANT
    END                              AS PLANT,
    BASIC_MATL,
    CASE
      WHEN PLANTCAT = '1710' THEN '1720'
      ELSE PLANTCAT
    END                              AS PLANTCAT,
    `0FISCVARNT`,
    `0FISCYEAR`,
    `0FISCPER`,
    NETVALUE
  FROM src_mapped
)

SELECT
  IMODOCCATR,
  VOLUMEUNIT,
  VOLUME,
  UPD_DATE,
  BASE_UOM,
  SUBTOT_OC1,
  SUBTOT_OC3,
  SUBTOT_OC2,
  COND_PR_UN,
  TAX_VALUE,
  UNIT,
  MATENTERD,
  PAYER,
  ITM_CAT,
  DOC_CURRCY,
  S4SHIP_TO,
  COMP_CODE,
  MATL_GROUP,
  NETPRICE,
  LOC_CURRCY,
  NET_WGT_DL,
  UNIT_OF_WT,
  AB_ITEM,
  DELIV_ITEM,
  BIC_ZMATEIAL1,
  STAT_CURR,
  TIME,
  CR_ON_I,
  REQDEKIQUANTY,
  PLANT,
  BASIC_MATL,
  PLANTCAT,
  `0FISCVARNT`,
  `0FISCYEAR`,
  NETVALUE
FROM end_routine_ZSA_ITM