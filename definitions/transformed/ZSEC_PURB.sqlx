config {
  type: "incremental",
  schema: "sales_cdc_poc",
  name: "ZSEC_PURB",
  uniqueKey: ["COMP_CODE", "DOC_TYPE", "SALESEMPLY"],
  tags: ["bw_migration"]
}

-- MERGE load: key fields are COMP_CODE, DOC_TYPE, SALESEMPLY
-- INCREMENTAL NOTE: no timestamp column available for delta filter;
-- full reload on every run. Add a WHERE clause when a delta key exists.

WITH
src_ZSEC_PURA AS (
  SELECT
    COMP_CODE,
    SALESEMPLY,
    IMODOCCATR,
    AMNT,
    STAT_CURR,
    S4SOLD_TO,
    CUST_GRP1,
    CPR_CREATE,
    LOC_CURRCY,
    AB_ITEM,
    CRMSALORGX,
    PR_CAT_SAL,
    `0FISCYEAR`,
    `0FISCVARNT`
  FROM ${ref("ZSEC_PURA")}
),

staged_ZSEC_PURB AS (
  SELECT
    COMP_CODE,
    COALESCE(SALESEMPLY, '')  AS SALESEMPLY,
    IMODOCCATR,
    AMNT,
    STAT_CURR,
    S4SOLD_TO,
    CUST_GRP1,
    CPR_CREATE,
    LOC_CURRCY,
    AB_ITEM,
    CRMSALORGX,
    PR_CAT_SAL,
    `0FISCYEAR`,
    `0FISCVARNT`,
    'CBG0' AS DOC_TYPE
  FROM src_ZSEC_PURA
)

SELECT
  COMP_CODE,
  SALESEMPLY,
  IMODOCCATR,
  AMNT,
  STAT_CURR,
  S4SOLD_TO,
  CUST_GRP1,
  CPR_CREATE,
  LOC_CURRCY,
  AB_ITEM,
  CRMSALORGX,
  PR_CAT_SAL,
  `0FISCYEAR`,
  `0FISCVARNT`,
  DOC_TYPE
FROM staged_ZSEC_PURB