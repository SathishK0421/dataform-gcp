config {
  type: "incremental",
  schema: "sales_cdc_poc",
  name: "ZDS_HDR1",
  uniqueKey: ["SALESEMPLY", "DOC_TYPE", "COMP_CODE"],
  tags: ["bw_migration"]
}

-- MERGE load: key fields are SALESEMPLY, DOC_TYPE, COMP_CODE

WITH
  src_ZDS_HDR AS (
    SELECT
      VBELN,
      PVRTNR,
      AUART,
      STWAE,
      KUNNR,
      ERDAT,
      KVGR1,
      VKORG,
      BUKRS,
      HWAER
    FROM ${ref("ZDS_HDR")}
  ),

  mapped_ZDS_HDR1 AS (
    SELECT
      COALESCE(VBELN, '')                      AS IMODOCCATR,
      COALESCE(PVRTNR, '')                     AS SALESEMPLY,
      COALESCE(AUART, '')                      AS DOC_TYPE,
      CAST(COALESCE(STWAE, '') AS STRING)      AS STAT_CURR,
      COALESCE(KUNNR, '')                      AS S4SOLD_TO,
      PARSE_DATE('%Y%m%d', ERDAT)              AS CPR_CREATE,
      COALESCE(KVGR1, '')                      AS CUST_GRP1,
      COALESCE(VKORG, '')                      AS CRMSALORGX,
      COALESCE(BUKRS, '')                      AS COMP_CODE,
      CAST(COALESCE(HWAER, '') AS STRING)      AS LOC_CURRCY
      -- NOTE: 0FISCVARNT calculated column spec states "SOURCE & TARGET FIELD SAME,
      --       NO LOGIC REQUIRED AS 0FISCVARNT" — no additional column emitted here
      --       as 0FISCVARNT does not appear in the Target field list.
    FROM src_ZDS_HDR
  )

SELECT
  IMODOCCATR,
  SALESEMPLY,
  DOC_TYPE,
  STAT_CURR,
  S4SOLD_TO,
  CPR_CREATE,
  CUST_GRP1,
  CRMSALORGX,
  COMP_CODE,
  LOC_CURRCY
FROM mapped_ZDS_HDR1
${when(incremental(), `WHERE CPR_CREATE > (
    SELECT MAX(CPR_CREATE) FROM ${self()}
)`)}