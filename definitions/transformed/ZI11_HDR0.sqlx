config {
  type: "incremental",
  schema: "sales_cdc_poc",
  name: "ZI11_HDR0",
  tags: ["bw_migration"]
}

WITH
src_ZA11_HDR0 AS (
  SELECT
    ROCANCEL,
    VBELN,
    BUCHK,
    AUART,
    AUGRU,
    BUKRS,
    ERDAT,
    FAKSK,
    HWAER,
    KUNNR,
    KURST,
    KVGR1,
    KVGR2,
    KVGR3,
    KVGR4,
    KVGR5,
    LIFSK,
    PVRTNR,
    STWAE,
    VBTYP,
    VDATU,
    VKBUR,
    VKGRP,
    VKORG,
    VTWEG,
    WAERK,
    AEDAT,
    AUDAT,
    AUFNR,
    AUTLF,
    BSARK,
    CMWAE,
    ERNAM,
    ERZET,
    KOKRS,
    KOSTL,
    KTEXT,
    LAND1,
    LAST_CHANGED_BY_USER,
    MANDT,
    NETWR,
    OBJNR,
    PKUNRE,
    PKUNRG,
    PKUNWE,
    SPART,
    UPD_TMSTMP,
    VSBED,
    VSNMR_V,
    SPARA,
    ANZAU,
    PERIV,
    ZZSALES_PERSON,
    ODQ_CHANGEMODE,
    ODQ_ENTITYCNTR
  FROM ${ref("ZA11_HDR0")}
),
staged_ZI11_HDR0 AS (
  SELECT
    s.ROCANCEL                          AS ROCANCEL,
    s.VBELN                             AS VBELN,
    s.BUCHK                             AS BUCHK,
    s.AUART                             AS AUART,
    s.AUGRU                             AS AUGRU,
    s.BUKRS                             AS BUKRS,
    s.ERDAT                             AS ERDAT,      -- _date_fields: already DATE
    s.FAKSK                             AS FAKSK,
    s.HWAER                             AS HWAER,      -- _waers_fields: STRING
    s.KUNNR                             AS KUNNR,      -- _numc_fields: STRING
    s.KURST                             AS KURST,
    s.KVGR1                             AS KVGR1,
    s.KVGR2                             AS KVGR2,
    s.KVGR3                             AS KVGR3,
    s.KVGR4                             AS KVGR4,
    s.KVGR5                             AS KVGR5,
    s.LIFSK                             AS LIFSK,
    s.PVRTNR                            AS PVRTNR,
    s.STWAE                             AS STWAE,      -- _waers_fields: STRING
    s.VBTYP                             AS VBTYP,
    s.VDATU                             AS VDATU,      -- _date_fields: already DATE
    s.VKBUR                             AS VKBUR,
    s.VKGRP                             AS VKGRP,
    s.VKORG                             AS VKORG,
    s.VTWEG                             AS VTWEG,
    s.WAERK                             AS WAERK,      -- _waers_fields: STRING
    s.AEDAT                             AS AEDAT,      -- _date_fields: already DATE
    s.AUDAT                             AS AUDAT,
    s.AUFNR                             AS AUFNR,      -- _numc_fields: STRING
    s.AUTLF                             AS AUTLF,
    s.BSARK                             AS BSARK,
    s.CMWAE                             AS CMWAE,
    s.ERNAM                             AS ERNAM,
    PARSE_TIME('%H%M%S', s.ERZET)       AS ERZET,      -- _tims_fields: HHMMSS -> TIME
    s.KOKRS                             AS KOKRS,
    s.KOSTL                             AS KOSTL,
    s.KTEXT                             AS KTEXT,
    s.LAND1                             AS LAND1,
    s.LAST_CHANGED_BY_USER              AS LAST_CHANGED_BY_USER,
    s.MANDT                             AS MANDT,
    s.NETWR                             AS NETWR,
    s.OBJNR                             AS OBJNR,
    s.PKUNRE                            AS PKUNRE,
    s.PKUNRG                            AS PKUNRG,
    s.PKUNWE                            AS PKUNWE,
    s.SPART                             AS SPART,
    s.UPD_TMSTMP                        AS UPD_TMSTMP,
    s.VSBED                             AS VSBED,
    s.VSNMR_V                           AS VSNMR_V,
    s.SPARA                             AS SPARA,
    s.ANZAU                             AS ANZAU,
    s.PERIV                             AS PERIV,
    s.ZZSALES_PERSON                    AS ZZSALES_PERSON,
    s.ODQ_CHANGEMODE                    AS ODQ_CHANGEMODE,
    s.ODQ_ENTITYCNTR                    AS ODQ_ENTITYCNTR
  FROM src_ZA11_HDR0 s
)

SELECT
  ROCANCEL,
  VBELN,
  BUCHK,
  AUART,
  AUGRU,
  BUKRS,
  ERDAT,
  FAKSK,
  HWAER,
  KUNNR,
  KURST,
  KVGR1,
  KVGR2,
  KVGR3,
  KVGR4,
  KVGR5,
  LIFSK,
  PVRTNR,
  STWAE,
  VBTYP,
  VDATU,
  VKBUR,
  VKGRP,
  VKORG,
  VTWEG,
  WAERK,
  AEDAT,
  AUDAT,
  AUFNR,
  AUTLF,
  BSARK,
  CMWAE,
  ERNAM,
  ERZET,
  KOKRS,
  KOSTL,
  KTEXT,
  LAND1,
  LAST_CHANGED_BY_USER,
  MANDT,
  NETWR,
  OBJNR,
  PKUNRE,
  PKUNRG,
  PKUNWE,
  SPART,
  UPD_TMSTMP,
  VSBED,
  VSNMR_V,
  SPARA,
  ANZAU,
  PERIV,
  ZZSALES_PERSON,
  ODQ_CHANGEMODE,
  ODQ_ENTITYCNTR
FROM staged_ZI11_HDR0
${when(incremental(), `WHERE UPD_TMSTMP > (
    SELECT IFNULL(MAX(UPD_TMSTMP), TIMESTAMP '1900-01-01 00:00:00') FROM ${self()}
)`)}