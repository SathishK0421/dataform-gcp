config {
    type: "view",
    //* schema: "sales_curated_poc",
    name: "uc_sales_stats_prepared",
    tags: ["staging", "uc_sales_stats", "billing", 'fact_gen'],
    description: "CTE-heavy preparation from CDC and mapping before final curated projection.",
    schema: dataform.projectConfig.vars.env === "prod" ?
        "sales_poc_prod" : dataform.projectConfig.vars.env === "staging" ?
        "sales_poc_stg" : "sales_poc_dev"
}

WITH
  CDC_WRAPPER AS (
  WITH
    UTIL_MAPPING AS (
    SELECT
      DIVISION,
      UTILITY,
      STATE,
      BACKCAST_UTILITY
    FROM
      ${ref("ZBT_UTIL_MAPPING")}
    WHERE
      SOURCE = 'CCS' ),
    SOURCE_BASE AS (
    SELECT
      *
    FROM
      ${ref("src_sales_cdc")} ),
    BUKRS_SPECIAL AS (
    SELECT
      S.*,
      CASE
        WHEN S.STGRQNT = 'RQENGY' AND S.MASSBILL = 'GJ' THEN S.MENGE
        ELSE S.ZZ_EDM_QTY
    END
      AS ZZ_EDM_QTY_OUT,
      CASE
        WHEN S.BUCHREL = 'X' THEN S.BETRAG
        ELSE CAST(0 AS NUMERIC)
    END
      AS ZZ_EDM_AMT_OUT,
      S.ZZ_EDM_FLG AS ZZ_EDM_FLG_OUT,
      S.VBRMONAT AS VBRMONAT_OUT,
      S.AB AS AB_OUT,
      S.BIS AS BIS_OUT,
      S.ANZTAGE AS ANZTAGE_OUT,
      S.ANZVERTR AS ANZVERTR_OUT,
      S.BETRAG AS BETRAG_OUT,
      S.MENGE AS MENGE_OUT
    FROM
      SOURCE_BASE S
    WHERE
      S.BUKRS IN (${constants.GAS_PRODUCT_CODES.map(c => `'${c}'`).join(",")}) ),
    NON_GAS_ROWS AS (
    SELECT
      S.*,
      S.ZZ_EDM_QTY AS ZZ_EDM_QTY_OUT,
      S.ZZ_EDM_AMT AS ZZ_EDM_AMT_OUT,
      S.ZZ_EDM_FLG AS ZZ_EDM_FLG_OUT,
      S.VBRMONAT AS VBRMONAT_OUT,
      S.AB AS AB_OUT,
      S.BIS AS BIS_OUT,
      S.ANZTAGE AS ANZTAGE_OUT,
      S.ANZVERTR AS ANZVERTR_OUT,
      S.BETRAG AS BETRAG_OUT,
      S.MENGE AS MENGE_OUT
    FROM
      SOURCE_BASE S
    WHERE
      S.BUKRS NOT IN (${constants.GAS_PRODUCT_CODES.map(c => `'${c}'`).join(",")})
      AND S.SPARTE <> ${constants.BU} ),
    GAS_ROWS AS (
    SELECT
      S.*
    FROM
      SOURCE_BASE S
    WHERE
      S.BUKRS NOT IN (${constants.GAS_PRODUCT_CODES.map(c => `'${c}'`).join(",")})
      AND S.SPARTE = ${constants.BU} ),
    GAS_SAME_MONTH AS (
    SELECT
      S.*,
      'NA' AS ZZ_EDM_FLG_OUT,
      CASE
        WHEN S.STGRQNT = 'RQENGY' AND S.MASSBILL IN ('THM', 'CCF', 'MCF', 'DTH', 'GJ') THEN S.MENGE
        ELSE S.ZZ_EDM_QTY
    END
      AS ZZ_EDM_QTY_OUT,
      CASE
        WHEN S.BUCHREL = 'X' THEN S.BETRAG
        ELSE S.ZZ_EDM_AMT
    END
      AS ZZ_EDM_AMT_OUT,
      SUBSTR(CAST(S.ZZERCH_BEGABRPE AS STRING), 1, 6) AS VBRMONAT_OUT,
      S.ZZERCH_BEGABRPE AS AB_OUT,
      S.ZZERCH_ENDABRPE AS BIS_OUT,
      S.ANZTAGE AS ANZTAGE_OUT,
      S.ANZVERTR AS ANZVERTR_OUT,
      S.BETRAG AS BETRAG_OUT,
      S.MENGE AS MENGE_OUT
    FROM
      GAS_ROWS S
    WHERE
      SUBSTR(CAST(S.ZZERCH_BEGABRPE AS STRING), 1, 6) = SUBSTR(CAST(S.ZZERCH_ENDABRPE AS STRING), 1, 6) ),
    GAS_MULTI AS (
    SELECT
      S.*
    FROM
      GAS_ROWS S
    WHERE
      SUBSTR(CAST(S.ZZERCH_BEGABRPE AS STRING), 1, 6) <> SUBSTR(CAST(S.ZZERCH_ENDABRPE AS STRING), 1, 6) ),
    GAS_MULTI_DERIVED AS (
    SELECT
      S.*,
      CASE
        WHEN S.ZZG_BRAND = 'NRGHOME' THEN 'NRG-R'
        WHEN STRPOS(S.ZZG_BRAND, 'STM') > 0 THEN 'STR'
        ELSE S.ZZG_BRAND
    END
      AS L_BRAND_CODE,
      CASE
        WHEN STRPOS(S.ZZG_PROD_TYPE, 'VAR') > 0 THEN 'V'
        ELSE 'F'
    END
      AS L_PRODUCT_TYPE,
      CASE
        WHEN STRPOS(S.ZZG_SEGMENT, 'SB') > 0 THEN 'SMALL COMMERCIAL'
        WHEN STRPOS(S.ZZG_SEGMENT, 'RES') > 0 THEN 'RESIDENTIAL'
        WHEN STRPOS(S.ZZG_SEGMENT, 'CI') > 0 THEN 'COMMERCIAL'
        ELSE 'RESIDENTIAL'
    END
      AS L_CUSTOMER_TYPE,
      CASE
        WHEN S.REGION IS NOT NULL AND S.REGION <> '' THEN S.REGION
        ELSE 'XXX'
    END
      AS L_REGION
    FROM
      GAS_MULTI S ),
    GAS_MULTI_UTIL_PRIMARY AS (
    SELECT
      D.*,
      UM1.BACKCAST_UTILITY AS BACKCAST_UTILITY_PRIMARY
    FROM
      GAS_MULTI_DERIVED D
    LEFT JOIN
      UTIL_MAPPING UM1
    ON
      UM1.DIVISION = D.SPARTE
      AND UM1.UTILITY = D.ZZG_UTILITY
      AND UM1.STATE = D.REGION ),
    GAS_MULTI_UTIL_FALLBACK AS (
    SELECT
      P.*,
      COALESCE(P.BACKCAST_UTILITY_PRIMARY, UM2.BACKCAST_UTILITY) AS L_UTILITY
    FROM
      GAS_MULTI_UTIL_PRIMARY P
    LEFT JOIN
      UTIL_MAPPING UM2
    ON
      UM2.DIVISION = P.SPARTE
      AND UM2.UTILITY = P.ZZG_UTILITY
      AND (P.BACKCAST_UTILITY_PRIMARY IS NULL
        OR P.BACKCAST_UTILITY_PRIMARY = '') ),
    GAS_MULTI_READY AS (
    SELECT
      *,
      CASE
        WHEN ZZG_UTILITY IS NOT NULL AND ZZG_UTILITY <> '' THEN COALESCE(NULLIF(L_UTILITY,''), 'XXX')
        ELSE NULL
    END
      AS EDC_RESOLVED
    FROM
      GAS_MULTI_UTIL_FALLBACK ),
    BACKCAST_RAW AS (
    SELECT
      ZBRANDCDE AS BRANDCODE,
      ZEDC AS EDC,
      ZSTATPROV AS STATPROV,
      ZCUSTTYPE AS CUSTTYPE,
      ZPRODTYPE AS PRODTYPE,
      ZUCLDDTCH AS LOADDATE,
      ZBURNRTIP AS BURNRTIP
    FROM
      ${ref("FACT_MDRP_GAS_ACCTG")} ),
    GAS_MONTH_SPINE AS (
    SELECT
      G.FIKEY AS G_FIKEY,
      G.ZZERCH_BEGABRPE,
      G.ZZERCH_ENDABRPE,
      G.EDC_RESOLVED,
      G.L_REGION,
      G.L_CUSTOMER_TYPE,
      G.L_PRODUCT_TYPE,
      G.L_BRAND_CODE,
      MONTH_START
    FROM
      GAS_MULTI_READY G
    CROSS JOIN
      UNNEST( GENERATE_DATE_ARRAY( DATE_TRUNC(CAST(G.ZZERCH_BEGABRPE AS DATE), MONTH), DATE_TRUNC(CAST(G.ZZERCH_ENDABRPE AS DATE), MONTH), INTERVAL 1 MONTH ) ) AS MONTH_START ),
    GAS_DAY_SPINE AS (
    SELECT
      G.FIKEY AS G_FIKEY,
      G.ZZERCH_BEGABRPE,
      G.ZZERCH_ENDABRPE,
      G.EDC_RESOLVED,
      G.L_REGION,
      G.L_CUSTOMER_TYPE,
      G.L_PRODUCT_TYPE,
      G.L_BRAND_CODE,
      D AS LOADDATE
    FROM
      GAS_MULTI_READY G
    CROSS JOIN
      UNNEST( GENERATE_DATE_ARRAY( CAST(G.ZZERCH_BEGABRPE AS DATE), CAST(G.ZZERCH_ENDABRPE AS DATE), INTERVAL 1 DAY ) ) AS D ),
    GAS_TOTAL_DAYS AS (
    SELECT
      G_FIKEY,
      ZZERCH_BEGABRPE,
      ZZERCH_ENDABRPE,
      COUNT(*) - 1 AS TOTAL_DAYS
    FROM
      GAS_DAY_SPINE
    GROUP BY
      G_FIKEY,
      ZZERCH_BEGABRPE,
      ZZERCH_ENDABRPE ),
    BACKCAST_DAY_PRIMARY AS (
    SELECT
      DS.*,
      BC.BURNRTIP
    FROM
      GAS_DAY_SPINE DS
    LEFT JOIN
      BACKCAST_RAW BC
    ON
      BC.BRANDCODE = DS.L_BRAND_CODE
      AND BC.EDC = DS.EDC_RESOLVED
      AND BC.STATPROV = DS.L_REGION
      AND BC.CUSTTYPE = DS.L_CUSTOMER_TYPE
      AND BC.PRODTYPE = DS.L_PRODUCT_TYPE
      AND BC.LOADDATE = DS.LOADDATE ),
    BACKCAST_FALLBACK_AVAIL AS (
    SELECT
      DS.G_FIKEY,
      DS.ZZERCH_BEGABRPE,
      DS.ZZERCH_ENDABRPE,
      DS.EDC_RESOLVED,
      DS.L_REGION,
      DS.L_BRAND_CODE,
      DS.L_CUSTOMER_TYPE,
      DS.L_PRODUCT_TYPE,
      MAX(CASE
          WHEN BC.BURNRTIP IS NOT NULL THEN 1
          ELSE 0
      END
        ) AS HAS_PRIMARY
    FROM
      GAS_DAY_SPINE DS
    LEFT JOIN
      BACKCAST_RAW BC
    ON
      BC.BRANDCODE = DS.L_BRAND_CODE
      AND BC.EDC = DS.EDC_RESOLVED
      AND BC.STATPROV = DS.L_REGION
      AND BC.CUSTTYPE = DS.L_CUSTOMER_TYPE
      AND BC.PRODTYPE = DS.L_PRODUCT_TYPE
      AND BC.LOADDATE = DS.LOADDATE
    GROUP BY
      DS.G_FIKEY,
      DS.ZZERCH_BEGABRPE,
      DS.ZZERCH_ENDABRPE,
      DS.EDC_RESOLVED,
      DS.L_REGION,
      DS.L_BRAND_CODE,
      DS.L_CUSTOMER_TYPE,
      DS.L_PRODUCT_TYPE ),
    BACKCAST_FALLBACK_POOL AS (
    SELECT
      FA.*,
      CASE
        WHEN FA.L_CUSTOMER_TYPE = 'RESIDENTIAL' THEN 'SMALL COMMERCIAL'
        ELSE 'RESIDENTIAL'
    END
      AS SWAPPED_CUSTTYPE,
      CASE
        WHEN FA.L_PRODUCT_TYPE = 'F' THEN 'V'
        ELSE 'F'
    END
      AS SWAPPED_PRODTYPE
    FROM
      BACKCAST_FALLBACK_AVAIL FA
    WHERE
      FA.HAS_PRIMARY = 0 ),
    BACKCAST_POOL_CHECK AS (
    SELECT
      FP.*,
      (
      SELECT
        COUNT(*)
      FROM
        BACKCAST_RAW BC2
      WHERE
        BC2.BRANDCODE = FP.L_BRAND_CODE
        AND BC2.EDC = FP.EDC_RESOLVED
        AND BC2.STATPROV = FP.L_REGION
        AND BC2.CUSTTYPE = FP.L_CUSTOMER_TYPE
        AND BC2.LOADDATE BETWEEN FP.ZZERCH_BEGABRPE
        AND FP.ZZERCH_ENDABRPE ) AS ORIG_CUST_CNT,
      (
      SELECT
        COUNT(*)
      FROM
        BACKCAST_RAW BC2
      WHERE
        BC2.BRANDCODE = FP.L_BRAND_CODE
        AND BC2.EDC = FP.EDC_RESOLVED
        AND BC2.STATPROV = FP.L_REGION
        AND BC2.PRODTYPE = FP.L_PRODUCT_TYPE
        AND BC2.LOADDATE BETWEEN FP.ZZERCH_BEGABRPE
        AND FP.ZZERCH_ENDABRPE ) AS ORIG_PROD_CNT
    FROM
      BACKCAST_FALLBACK_POOL FP ),
    BACKCAST_FINAL_PARAMS AS (
    SELECT
      PC.*,
      CASE
        WHEN PC.ORIG_CUST_CNT = 0 THEN PC.SWAPPED_CUSTTYPE
        ELSE PC.L_CUSTOMER_TYPE
    END
      AS FINAL_CUSTTYPE,
      CASE
        WHEN PC.ORIG_PROD_CNT = 0 THEN PC.SWAPPED_PRODTYPE
        ELSE PC.L_PRODUCT_TYPE
    END
      AS FINAL_PRODTYPE
    FROM
      BACKCAST_POOL_CHECK PC ),
    BACKCAST_DAY_RESOLVED AS (
    SELECT
      DP.G_FIKEY,
      DP.ZZERCH_BEGABRPE,
      DP.ZZERCH_ENDABRPE,
      DP.LOADDATE,
      DP.L_CUSTOMER_TYPE AS FINAL_CUSTTYPE,
      DP.L_PRODUCT_TYPE AS FINAL_PRODTYPE,
      DP.BURNRTIP,
      1 AS HAS_PRIMARY
    FROM
      BACKCAST_DAY_PRIMARY DP
    INNER JOIN
      BACKCAST_FALLBACK_AVAIL FA
    ON
      FA.G_FIKEY = DP.G_FIKEY
      AND FA.HAS_PRIMARY = 1
    UNION ALL
    SELECT
      DS.G_FIKEY,
      DS.ZZERCH_BEGABRPE,
      DS.ZZERCH_ENDABRPE,
      DS.LOADDATE,
      FP.FINAL_CUSTTYPE,
      FP.FINAL_PRODTYPE,
      BC3.BURNRTIP,
      0 AS HAS_PRIMARY
    FROM
      GAS_DAY_SPINE DS
    INNER JOIN
      BACKCAST_FINAL_PARAMS FP
    ON
      FP.G_FIKEY = DS.G_FIKEY
    LEFT JOIN
      BACKCAST_RAW BC3
    ON
      BC3.BRANDCODE = DS.L_BRAND_CODE
      AND BC3.EDC = DS.EDC_RESOLVED
      AND BC3.STATPROV = DS.L_REGION
      AND BC3.CUSTTYPE = FP.FINAL_CUSTTYPE
      AND BC3.PRODTYPE = FP.FINAL_PRODTYPE
      AND BC3.LOADDATE = DS.LOADDATE ),
    BACKCAST_QUALITY AS (
    SELECT
      DR.G_FIKEY,
      DR.ZZERCH_BEGABRPE,
      DR.ZZERCH_ENDABRPE,
      COUNT(DISTINCT DR.LOADDATE) AS TOTAL_DAYS_IN_RANGE,
      COUNT(DISTINCT
        CASE
          WHEN COALESCE(DR.BURNRTIP,0) <> 0 THEN DR.LOADDATE
      END
        ) AS MATCHED_DAYS
    FROM
      BACKCAST_DAY_RESOLVED DR
    GROUP BY
      DR.G_FIKEY,
      DR.ZZERCH_BEGABRPE,
      DR.ZZERCH_ENDABRPE ),
    BACKCAST_USE_FLAG AS (
    SELECT
      Q.*,
      CASE
        WHEN (Q.TOTAL_DAYS_IN_RANGE - Q.MATCHED_DAYS) > 7 THEN FALSE
        ELSE TRUE
    END
      AS USE_BACKCAST
    FROM
      BACKCAST_QUALITY Q ),
    BACKCAST_MONTHLY_SUM AS (
    SELECT
      DR.G_FIKEY,
      DR.ZZERCH_BEGABRPE,
      DR.ZZERCH_ENDABRPE,
      FORMAT_DATE('%Y%m', DR.LOADDATE) AS CAL_MO,
      SUM(COALESCE(DR.BURNRTIP, 0)) AS QTY_0,
      COUNT(DR.LOADDATE) AS QTY_1
    FROM
      BACKCAST_DAY_RESOLVED DR
    GROUP BY
      DR.G_FIKEY,
      DR.ZZERCH_BEGABRPE,
      DR.ZZERCH_ENDABRPE,
      FORMAT_DATE('%Y%m', DR.LOADDATE) ),
    TOTAL_BACKCAST_QTY AS (
    SELECT
      G_FIKEY,
      ZZERCH_BEGABRPE,
      ZZERCH_ENDABRPE,
      SUM(QTY_0) AS TOTAL_QTY_0,
      SUM(QTY_1) AS TOTAL_QTY_1
    FROM
      BACKCAST_MONTHLY_SUM
    GROUP BY
      G_FIKEY,
      ZZERCH_BEGABRPE,
      ZZERCH_ENDABRPE ),
    MONTHLY_FRACTIONS AS (
    SELECT
      MS.G_FIKEY,
      MS.ZZERCH_BEGABRPE,
      MS.ZZERCH_ENDABRPE,
      MS.CAL_MO,
      MS.QTY_0,
      MS.QTY_1,
      TBQ.TOTAL_QTY_0,
      TBQ.TOTAL_QTY_1,
      UF.USE_BACKCAST,
      CASE
        WHEN UF.USE_BACKCAST AND TBQ.TOTAL_QTY_0 <> 0 THEN SAFE_DIVIDE(MS.QTY_0, TBQ.TOTAL_QTY_0)
        ELSE SAFE_DIVIDE(MS.QTY_1, TBQ.TOTAL_QTY_1)
    END
      AS FRACTION,
      SAFE_DIVIDE(MS.QTY_1, TBQ.TOTAL_QTY_1) AS FRACTION_AVG,
      CASE
        WHEN UF.USE_BACKCAST AND TBQ.TOTAL_QTY_0 <> 0 THEN 'BC'
        ELSE 'AV'
    END
      AS FMA_TYPE
    FROM
      BACKCAST_MONTHLY_SUM MS
    JOIN
      TOTAL_BACKCAST_QTY TBQ
    ON
      TBQ.G_FIKEY = MS.G_FIKEY
      AND TBQ.ZZERCH_BEGABRPE = MS.ZZERCH_BEGABRPE
      AND TBQ.ZZERCH_ENDABRPE = MS.ZZERCH_ENDABRPE
    JOIN
      BACKCAST_USE_FLAG UF
    ON
      UF.G_FIKEY = MS.G_FIKEY
      AND UF.ZZERCH_BEGABRPE = MS.ZZERCH_BEGABRPE
      AND UF.ZZERCH_ENDABRPE = MS.ZZERCH_ENDABRPE ),
    GAS_MULTI_EXPANDED AS (
    SELECT
      G.*,
      MF.CAL_MO,
      MF.FRACTION,
      MF.FRACTION_AVG,
      MF.FMA_TYPE,
      DATE_DIFF(CAST(G.ZZERCH_ENDABRPE AS DATE), CAST(G.ZZERCH_BEGABRPE AS DATE), DAY) AS L_NODAYS,
      ROW_NUMBER() OVER (PARTITION BY G.FIKEY, G.ZZERCH_BEGABRPE, G.ZZERCH_ENDABRPE ORDER BY MF.CAL_MO ) AS RN,
      COUNT(*) OVER (PARTITION BY G.FIKEY, G.ZZERCH_BEGABRPE, G.ZZERCH_ENDABRPE ) AS TOTAL_MONTHS
    FROM
      GAS_MULTI_READY G
    JOIN
      MONTHLY_FRACTIONS MF
    ON
      MF.G_FIKEY = G.FIKEY
      AND MF.ZZERCH_BEGABRPE = G.ZZERCH_BEGABRPE
      AND MF.ZZERCH_ENDABRPE = G.ZZERCH_ENDABRPE ),
    GAS_MULTI_ORIG AS (
    SELECT
      G.*,
      CASE
        WHEN G.STGRQNT = 'RQENGY' AND G.MASSBILL IN ('THM', 'CCF', 'MCF', 'DTH', 'GJ') THEN G.MENGE
        ELSE CAST(0 AS NUMERIC)
    END
      AS L_ORIG_ZZ_EDM_QTY,
      CASE
        WHEN G.BUCHREL = 'X' THEN G.BETRAG
        ELSE CAST(0 AS NUMERIC)
    END
      AS L_ORIG_ZZ_EDM_AMT
    FROM
      GAS_MULTI_READY G ),
    GAS_MULTI_ALLOCATED AS (
    SELECT
      E.*,
      O.L_ORIG_ZZ_EDM_QTY,
      O.L_ORIG_ZZ_EDM_AMT,
      ROUND(CAST(O.BETRAG AS NUMERIC) * CAST(E.FRACTION AS NUMERIC), 2) AS BETRAG_ALLOC,
      ROUND(CAST(O.MENGE AS NUMERIC) * CAST(E.FRACTION AS NUMERIC), 3) AS MENGE_ALLOC,
      ROUND(CAST(O.ANZTAGE AS NUMERIC) * CAST(E.FRACTION_AVG AS NUMERIC), 0) AS ANZTAGE_ALLOC,
      ROUND(CAST(O.ANZVERTR AS NUMERIC) * CAST(E.FRACTION_AVG AS NUMERIC), 3) AS ANZVERTR_ALLOC,
      ROUND(CAST(O.L_ORIG_ZZ_EDM_QTY AS NUMERIC) * CAST(E.FRACTION AS NUMERIC), 3) AS ZZ_EDM_QTY_ALLOC,
      ROUND(CAST(O.L_ORIG_ZZ_EDM_AMT AS NUMERIC) * CAST(E.FRACTION AS NUMERIC), 2) AS ZZ_EDM_AMT_ALLOC,
      SUM(ROUND(CAST(O.BETRAG AS NUMERIC) * CAST(E.FRACTION AS NUMERIC), 2)) OVER (PARTITION BY E.FIKEY, E.ZZERCH_BEGABRPE, E.ZZERCH_ENDABRPE ORDER BY E.CAL_MO ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS SUM_BETRAG_PREV,
      SUM(ROUND(CAST(O.MENGE AS NUMERIC) * CAST(E.FRACTION AS NUMERIC), 3)) OVER (PARTITION BY E.FIKEY, E.ZZERCH_BEGABRPE, E.ZZERCH_ENDABRPE ORDER BY E.CAL_MO ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS SUM_MENGE_PREV,
      SUM(ROUND(CAST(O.ANZTAGE AS NUMERIC) * CAST(E.FRACTION_AVG AS NUMERIC), 0)) OVER (PARTITION BY E.FIKEY, E.ZZERCH_BEGABRPE, E.ZZERCH_ENDABRPE ORDER BY E.CAL_MO ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS SUM_ANZTAGE_PREV,
      SUM(ROUND(CAST(O.ANZVERTR AS NUMERIC) * CAST(E.FRACTION_AVG AS NUMERIC), 3)) OVER (PARTITION BY E.FIKEY, E.ZZERCH_BEGABRPE, E.ZZERCH_ENDABRPE ORDER BY E.CAL_MO ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS SUM_ANZVERTR_PREV,
      SUM(ROUND(CAST(O.L_ORIG_ZZ_EDM_QTY AS NUMERIC) * CAST(E.FRACTION AS NUMERIC), 3)) OVER (PARTITION BY E.FIKEY, E.ZZERCH_BEGABRPE, E.ZZERCH_ENDABRPE ORDER BY E.CAL_MO ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS SUM_EDM_QTY_PREV,
      SUM(ROUND(CAST(O.L_ORIG_ZZ_EDM_AMT AS NUMERIC) * CAST(E.FRACTION AS NUMERIC), 2)) OVER (PARTITION BY E.FIKEY, E.ZZERCH_BEGABRPE, E.ZZERCH_ENDABRPE ORDER BY E.CAL_MO ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS SUM_EDM_AMT_PREV
    FROM
      GAS_MULTI_EXPANDED E
    JOIN
      GAS_MULTI_ORIG O
    ON
      O.FIKEY = E.FIKEY
      AND O.ZZERCH_BEGABRPE = E.ZZERCH_BEGABRPE
      AND O.ZZERCH_ENDABRPE = E.ZZERCH_ENDABRPE ),
    GAS_MULTI_FINAL AS (
    SELECT
      A.*,
      CASE
        WHEN A.RN = A.TOTAL_MONTHS THEN CAST(A.BETRAG AS NUMERIC) - COALESCE(A.SUM_BETRAG_PREV, 0)
        ELSE A.BETRAG_ALLOC
    END
      AS BETRAG_OUT,
      CASE
        WHEN A.RN = A.TOTAL_MONTHS THEN CAST(A.MENGE AS NUMERIC) - COALESCE(A.SUM_MENGE_PREV, 0)
        ELSE A.MENGE_ALLOC
    END
      AS MENGE_OUT,
      CASE
        WHEN A.RN = A.TOTAL_MONTHS THEN CAST(A.ANZTAGE AS NUMERIC) - COALESCE(A.SUM_ANZTAGE_PREV, 0)
        ELSE A.ANZTAGE_ALLOC
    END
      AS ANZTAGE_OUT,
      CASE
        WHEN A.RN = A.TOTAL_MONTHS THEN CAST(A.ANZVERTR AS NUMERIC) - COALESCE(A.SUM_ANZVERTR_PREV, 0)
        ELSE A.ANZVERTR_ALLOC
    END
      AS ANZVERTR_OUT,
      CASE
        WHEN A.RN = A.TOTAL_MONTHS THEN A.L_ORIG_ZZ_EDM_QTY - COALESCE(A.SUM_EDM_QTY_PREV, 0)
        ELSE A.ZZ_EDM_QTY_ALLOC
    END
      AS ZZ_EDM_QTY_OUT,
      CASE
        WHEN A.RN = A.TOTAL_MONTHS THEN A.L_ORIG_ZZ_EDM_AMT - COALESCE(A.SUM_EDM_AMT_PREV, 0)
        ELSE A.ZZ_EDM_AMT_ALLOC
    END
      AS ZZ_EDM_AMT_OUT,
      A.FMA_TYPE AS ZZ_EDM_FLG_OUT,
      A.CAL_MO AS VBRMONAT_OUT,
      CASE
        WHEN A.CAL_MO = SUBSTR(CAST(A.ZZERCH_BEGABRPE AS STRING), 1, 6) THEN A.ZZERCH_BEGABRPE
        ELSE DATE(CAST(CONCAT(SUBSTR(A.CAL_MO,1,4),'-',SUBSTR(A.CAL_MO,5,2),'-01') AS DATE))
    END
      AS AB_OUT,
      CASE
        WHEN A.CAL_MO = SUBSTR(CAST(A.ZZERCH_ENDABRPE AS STRING), 1, 6) THEN A.ZZERCH_ENDABRPE
        ELSE DATE_SUB( DATE_ADD(DATE(CAST(CONCAT(SUBSTR(A.CAL_MO,1,4),'-',SUBSTR(A.CAL_MO,5,2),'-01') AS DATE)), INTERVAL 1 MONTH), INTERVAL 1 DAY )
    END
      AS BIS_OUT
    FROM
      GAS_MULTI_ALLOCATED A ),
    ALL_ROWS AS (
    SELECT
      S.MWSKZ,
      S.GPARTNER,
      S.GSBER,
      S.APPLK,
      S.VKONT,
      S.HVORG,
      S.TVORG,
      S.CITYP_CODE,
      S.COUNTRY,
      S.CITY_CODE,
      S.BUKRS,
      S.KOSTL,
      S.WAERS,
      S.KOKRS,
      S.AB_OUT AS AB,
      S.BIS_OUT AS BIS,
      S.KTOKLASSE,
      S.SPARTE,
      S.STPRZ,
      S.BRANCHE,
      S.TXJCD,
      S.BUDAT,
      S.REGION,
      S.STREETCODE,
      S.ANZTAGE_OUT AS ANZTAGE,
      S.ARTMENGE,
      S.AKLASSE,
      S.ANZVERTR_OUT AS ANZVERTR,
      S.KONZIGR,
      S.DIFFKZ,
      S.KONZVER,
      S.FRAN_TYPE,
      S.ZZHKONT,
      S.ANLART,
      S.ZZ_EINZDAT,
      S.ZZ_AUSZDAT,
      S.EIGENVERBR,
      S.DRCKSTUF,
      S.MENGE_OUT AS MENGE,
      S.KONDIGR,
      S.BETRAG_OUT AS BETRAG,
      S.SPEBENE,
      S.BUCHREL,
      S.MASSBILL,
      S.ZZ_EDM_AMT_OUT AS ZZ_EDM_AMT,
      S.ZZ_UEBUD_IND,
      S.ZZ_EDM_QTY_OUT AS ZZ_EDM_QTY,
      S.ZZFI_BUDAT,
      S.ZZ_MTR_TYPE,
      S.BELNR,
      S.VERTRAG,
      S.ZZSEGMENT,
      S.ZZCUST_TYPE,
      S.ZZ_OPBEL,
      S.ZZENDABRPE,
      S.ZZ_EDM_FLG_OUT AS ZZ_EDM_FLG,
      S.FIKEY,
      S.ZZ_GRT_PCT,
      S.ANLAGE,
      S.BELZART,
      S.ZZBEGABRPE,
      S.PRCTR,
      S.XCANC,
      S.ZZ_TBPSTART,
      S.ZZG_BRAND,
      S.ZZPL_GROUP,
      S.ZZGERAET,
      S.ZZEXT_UI,
      S.ZZ_CONGSTZONE,
      S.ZZ_ENERGYPRC_CHR,
      S.ZZ_ZIEAGT,
      S.ZZ_ZIECST,
      S.ZZ_RTFLG,
      S.ZZERCH_BEGABRPE,
      S.ZZERCH_ENDABRPE,
      S.ZZPROD_TYPE,
      S.ZZ_EIN01,
      S.ZZG_UTILITY,
      S.ZZG_PROD_TYPE,
      S.ZZG_SEGMENT,
      S.ZZFAEDN,
      S.ZZORF_TYPE,
      S.KOFIZ,
      S.ZZKOFIZ_SD,
      S.ZZNE_IND,
      S.VBRMONAT_OUT AS VBRMONAT,
      S.PORTION,
      S.STGRQNT
    FROM
      BUKRS_SPECIAL S
    UNION ALL
    SELECT
      S.MWSKZ,
      S.GPARTNER,
      S.GSBER,
      S.APPLK,
      S.VKONT,
      S.HVORG,
      S.TVORG,
      S.CITYP_CODE,
      S.COUNTRY,
      S.CITY_CODE,
      S.BUKRS,
      S.KOSTL,
      S.WAERS,
      S.KOKRS,
      S.AB_OUT AS AB,
      S.BIS_OUT AS BIS,
      S.KTOKLASSE,
      S.SPARTE,
      S.STPRZ,
      S.BRANCHE,
      S.TXJCD,
      S.BUDAT,
      S.REGION,
      S.STREETCODE,
      S.ANZTAGE_OUT AS ANZTAGE,
      S.ARTMENGE,
      S.AKLASSE,
      S.ANZVERTR_OUT AS ANZVERTR,
      S.KONZIGR,
      S.DIFFKZ,
      S.KONZVER,
      S.FRAN_TYPE,
      S.ZZHKONT,
      S.ANLART,
      S.ZZ_EINZDAT,
      S.ZZ_AUSZDAT,
      S.EIGENVERBR,
      S.DRCKSTUF,
      S.MENGE_OUT AS MENGE,
      S.KONDIGR,
      S.BETRAG_OUT AS BETRAG,
      S.SPEBENE,
      S.BUCHREL,
      S.MASSBILL,
      S.ZZ_EDM_AMT_OUT AS ZZ_EDM_AMT,
      S.ZZ_UEBUD_IND,
      S.ZZ_EDM_QTY_OUT AS ZZ_EDM_QTY,
      S.ZZFI_BUDAT,
      S.ZZ_MTR_TYPE,
      S.BELNR,
      S.VERTRAG,
      S.ZZSEGMENT,
      S.ZZCUST_TYPE,
      S.ZZ_OPBEL,
      S.ZZENDABRPE,
      S.ZZ_EDM_FLG_OUT AS ZZ_EDM_FLG,
      S.FIKEY,
      S.ZZ_GRT_PCT,
      S.ANLAGE,
      S.BELZART,
      S.ZZBEGABRPE,
      S.PRCTR,
      S.XCANC,
      S.ZZ_TBPSTART,
      S.ZZG_BRAND,
      S.ZZPL_GROUP,
      S.ZZGERAET,
      S.ZZEXT_UI,
      S.ZZ_CONGSTZONE,
      S.ZZ_ENERGYPRC_CHR,
      S.ZZ_ZIEAGT,
      S.ZZ_ZIECST,
      S.ZZ_RTFLG,
      S.ZZERCH_BEGABRPE,
      S.ZZERCH_ENDABRPE,
      S.ZZPROD_TYPE,
      S.ZZ_EIN01,
      S.ZZG_UTILITY,
      S.ZZG_PROD_TYPE,
      S.ZZG_SEGMENT,
      S.ZZFAEDN,
      S.ZZORF_TYPE,
      S.KOFIZ,
      S.ZZKOFIZ_SD,
      S.ZZNE_IND,
      S.VBRMONAT_OUT AS VBRMONAT,
      S.PORTION,
      S.STGRQNT
    FROM
      NON_GAS_ROWS S
    UNION ALL
    SELECT
      S.MWSKZ,
      S.GPARTNER,
      S.GSBER,
      S.APPLK,
      S.VKONT,
      S.HVORG,
      S.TVORG,
      S.CITYP_CODE,
      S.COUNTRY,
      S.CITY_CODE,
      S.BUKRS,
      S.KOSTL,
      S.WAERS,
      S.KOKRS,
      CAST(S.AB_OUT AS DATE) AS AB,
      CAST(S.BIS_OUT AS DATE) AS BIS,
      S.KTOKLASSE,
      S.SPARTE,
      S.STPRZ,
      S.BRANCHE,
      S.TXJCD,
      S.BUDAT,
      S.REGION,
      S.STREETCODE,
      CAST(S.ANZTAGE_OUT AS NUMERIC) AS ANZTAGE,
      S.ARTMENGE,
      S.AKLASSE,
      CAST(S.ANZVERTR_OUT AS NUMERIC) AS ANZVERTR,
      S.KONZIGR,
      S.DIFFKZ,
      S.KONZVER,
      S.FRAN_TYPE,
      S.ZZHKONT,
      S.ANLART,
      S.ZZ_EINZDAT,
      S.ZZ_AUSZDAT,
      S.EIGENVERBR,
      S.DRCKSTUF,
      CAST(S.MENGE_OUT AS NUMERIC) AS MENGE,
      S.KONDIGR,
      CAST(S.BETRAG_OUT AS NUMERIC) AS BETRAG,
      S.SPEBENE,
      S.BUCHREL,
      S.MASSBILL,
      CAST(S.ZZ_EDM_AMT_OUT AS NUMERIC) AS ZZ_EDM_AMT,
      S.ZZ_UEBUD_IND,
      CAST(S.ZZ_EDM_QTY_OUT AS NUMERIC) AS ZZ_EDM_QTY,
      S.ZZFI_BUDAT,
      S.ZZ_MTR_TYPE,
      S.BELNR,
      S.VERTRAG,
      S.ZZSEGMENT,
      S.ZZCUST_TYPE,
      S.ZZ_OPBEL,
      S.ZZENDABRPE,
      S.ZZ_EDM_FLG_OUT AS ZZ_EDM_FLG,
      S.FIKEY,
      S.ZZ_GRT_PCT,
      S.ANLAGE,
      S.BELZART,
      S.ZZBEGABRPE,
      S.PRCTR,
      S.XCANC,
      S.ZZ_TBPSTART,
      S.ZZG_BRAND,
      S.ZZPL_GROUP,
      ${helper.clean_portion("S.ZZGERAET")} AS ZZGERAET,
      ${helper.clean_portion("S.ZZEXT_UI")} AS ZZEXT_UI,
      --REGEXP_REPLACE(S.ZZGERAET, R'[^X20-X7E]', '') AS ZZGERAET,
      --REGEXP_REPLACE(S.ZZEXT_UI, R'[^X20-X7E]', '') AS ZZEXT_UI,
      S.ZZ_CONGSTZONE,
      S.ZZ_ENERGYPRC_CHR,
      S.ZZ_ZIEAGT,
      S.ZZ_ZIECST,
      S.ZZ_RTFLG,
      S.ZZERCH_BEGABRPE,
      S.ZZERCH_ENDABRPE,
      S.ZZPROD_TYPE,
      S.ZZ_EIN01,
      S.ZZG_UTILITY,
      S.ZZG_PROD_TYPE,
      S.ZZG_SEGMENT,
      S.ZZFAEDN,
      S.ZZORF_TYPE,
      S.KOFIZ,
      S.ZZKOFIZ_SD,
      S.ZZNE_IND,
      S.VBRMONAT_OUT AS VBRMONAT,
      S.PORTION,
      S.STGRQNT
    FROM
      GAS_SAME_MONTH S
    UNION ALL
    SELECT
      F.MWSKZ,
      F.GPARTNER,
      F.GSBER,
      F.APPLK,
      F.VKONT,
      F.HVORG,
      F.TVORG,
      F.CITYP_CODE,
      F.COUNTRY,
      F.CITY_CODE,
      F.BUKRS,
      F.KOSTL,
      F.WAERS,
      F.KOKRS,
      CAST(F.AB_OUT AS DATE) AS AB,
      CAST(F.BIS_OUT AS DATE) AS BIS,
      F.KTOKLASSE,
      F.SPARTE,
      F.STPRZ,
      F.BRANCHE,
      F.TXJCD,
      F.BUDAT,
      F.REGION,
      F.STREETCODE,
      CAST(F.ANZTAGE_OUT AS NUMERIC) AS ANZTAGE,
      F.ARTMENGE,
      F.AKLASSE,
      CAST(F.ANZVERTR_OUT AS NUMERIC) AS ANZVERTR,
      F.KONZIGR,
      F.DIFFKZ,
      F.KONZVER,
      F.FRAN_TYPE,
      F.ZZHKONT,
      F.ANLART,
      F.ZZ_EINZDAT,
      F.ZZ_AUSZDAT,
      F.EIGENVERBR,
      F.DRCKSTUF,
      CAST(F.MENGE_OUT AS NUMERIC) AS MENGE,
      F.KONDIGR,
      CAST(F.BETRAG_OUT AS NUMERIC) AS BETRAG,
      F.SPEBENE,
      F.BUCHREL,
      F.MASSBILL,
      CAST(F.ZZ_EDM_AMT_OUT AS NUMERIC) AS ZZ_EDM_AMT,
      F.ZZ_UEBUD_IND,
      CAST(F.ZZ_EDM_QTY_OUT AS NUMERIC) AS ZZ_EDM_QTY,
      F.ZZFI_BUDAT,
      F.ZZ_MTR_TYPE,
      F.BELNR,
      F.VERTRAG,
      F.ZZSEGMENT,
      F.ZZCUST_TYPE,
      F.ZZ_OPBEL,
      F.ZZENDABRPE,
      F.ZZ_EDM_FLG_OUT AS ZZ_EDM_FLG,
      F.FIKEY,
      F.ZZ_GRT_PCT,
      F.ANLAGE,
      F.BELZART,
      F.ZZBEGABRPE,
      F.PRCTR,
      F.XCANC,
      F.ZZ_TBPSTART,
      F.ZZG_BRAND,
      F.ZZPL_GROUP,
      ${helper.clean_portion("F.ZZGERAET")} AS ZZGERAET,
      ${helper.clean_portion("F.ZZEXT_UI")} AS ZZEXT_UI,
      --REGEXP_REPLACE(F.ZZGERAET, R'[^X20-X7E]', '') AS ZZGERAET,
      --REGEXP_REPLACE(F.ZZEXT_UI, R'[^X20-X7E]', '') AS ZZEXT_UI,
      F.ZZ_CONGSTZONE,
      F.ZZ_ENERGYPRC_CHR,
      F.ZZ_ZIEAGT,
      F.ZZ_ZIECST,
      F.ZZ_RTFLG,
      F.ZZERCH_BEGABRPE,
      F.ZZERCH_ENDABRPE,
      F.ZZPROD_TYPE,
      F.ZZ_EIN01,
      F.ZZG_UTILITY,
      F.ZZG_PROD_TYPE,
      F.ZZG_SEGMENT,
      F.ZZFAEDN,
      F.ZZORF_TYPE,
      F.KOFIZ,
      F.ZZKOFIZ_SD,
      F.ZZNE_IND,
      F.VBRMONAT_OUT AS VBRMONAT,
      F.PORTION,
      F.STGRQNT
    FROM
      GAS_MULTI_FINAL F )
  SELECT
    R.MWSKZ AS BBP_TAXCOD,
    R.GPARTNER AS BPARTNER,
    R.GSBER AS BUS_AREA,
    R.APPLK AS CAAPPLK,
    R.VKONT AS CACONT_ACC,
    R.HVORG AS CAMNTRANS,
    R.TVORG AS CASUBTRANS,
    R.CITYP_CODE AS CITYP_CODE,
    R.COUNTRY AS COUNTRY,
    R.CITY_CODE AS CITY_CODE,
    R.BUKRS AS COMP_CODE,
    R.KOSTL AS COSTCENTER,
    R.WAERS AS CURRENCY,
    R.KOKRS AS CO_AREA,
    CAST(R.AB AS DATE) AS DATEFROM,
    CAST(R.BIS AS DATE) AS DATETO,
    R.KTOKLASSE AS UCACC_CLAS,
    R.SPARTE AS DIVISION,
    R.STPRZ AS FC_TAXRATE,
    R.BRANCHE AS IND_CODE,
    R.TXJCD AS ME_TXJCD,
    R.BUDAT AS PSTNG_DATE,
    R.REGION AS REGION,
    R.STREETCODE AS STREET_COD,
    CAST(R.ANZTAGE AS NUMERIC) AS UCCONT_CNT,
    R.ARTMENGE AS UCAMT_TYPE,
    R.AKLASSE AS UCBILL_CLA,
    CAST(R.ANZVERTR AS NUMERIC) AS UCCNTRCNT,
    R.KONZIGR AS UCFRANCHGR,
    R.DIFFKZ AS UCDISC_IND,
    R.KONZVER AS UCFRANCNTR,
    R.FRAN_TYPE AS UCFRAN_CAT,
    R.ZZHKONT AS ZUCGLACCT,
    R.ANLART AS UCINST_TY,
    CAST(R.ZZ_EINZDAT AS DATE) AS UCMOVEIN_D,
    CAST(R.ZZ_AUSZDAT AS DATE) AS UCMOVEOUTD,
    R.EIGENVERBR AS UCOWNCONS,
    R.DRCKSTUF AS UCPRESLEVL,
    CAST(R.MENGE AS NUMERIC) AS UCQUANT,
    R.KONDIGR AS UCRATEFAKT,
    CAST(R.BETRAG AS NUMERIC) AS VAR_VR,
    R.SPEBENE AS UCVOLTLEVL,
    R.BUCHREL AS UC_POSTREL,
    R.MASSBILL AS UNIT,
    CAST(R.ZZ_EDM_AMT AS NUMERIC) AS ZEDMAMT,
    R.ZZ_UEBUD_IND AS ZALTPSTIN,
    CAST(R.ZZ_EDM_QTY AS NUMERIC) AS ZEDMQTY,
    CAST(R.ZZFI_BUDAT AS DATE) AS ZFIPSTDAT,
    R.ZZ_MTR_TYPE AS ZUCMTRTYP,
    R.BELNR AS ZUCBILDOC,
    R.VERTRAG AS ZUCCONTRA,
    R.ZZSEGMENT AS ZUCCUSSEG,
    R.ZZCUST_TYPE AS ZUCCUSTYP,
    R.ZZ_OPBEL AS ZUCDOCINV,
    CAST(R.ZZENDABRPE AS DATE) AS ZUCEBILPC,
    R.ZZ_EDM_FLG AS ZUCFMALTY,
    R.FIKEY AS ZUCRECKEY,
    R.ZZ_GRT_PCT AS ZUCGRTRAT,
    R.ANLAGE AS ZUCINSTAL,
    R.BELZART AS ZUCLINETY,
    CAST(R.ZZBEGABRPE AS DATE) AS ZUCSBILPC,
    R.PRCTR AS ZUCPRCTR,
    R.XCANC AS ZUCXCANC,
    CAST(R.ZZ_TBPSTART AS DATE) AS ZUCTDATFR,
    R.ZZG_BRAND AS ZBRANDCDE,
    R.ZZPL_GROUP AS ZPLGROUP,
    TRIM(R.ZZGERAET) AS ZUCSERIAL,
    TRIM(R.ZZEXT_UI) AS ZUCESID,
    R.ZZ_CONGSTZONE AS ZUCCONGZN,
    R.ZZ_ENERGYPRC_CHR AS ZENGYPRCC,
    R.ZZ_ZIEAGT AS ZUCAGTID,
    R.ZZ_ZIECST AS ZUCCSTID,
    R.ZZ_RTFLG AS ZUCRT_IND,
    CAST(R.ZZERCH_BEGABRPE AS DATE) AS UC_DATEFRO,
    CAST(R.ZZERCH_ENDABRPE AS DATE) AS UC_DATETO,
    R.ZZPROD_TYPE AS ZUCPRDTYP,
    R.ZZ_EIN01 AS ZUCOPRND1,
    R.ZZG_UTILITY AS X_RMUTLCD,
    R.ZZG_PROD_TYPE AS X_PRDTERM,
    R.ZZG_SEGMENT AS ZCUSTYPCD,
    CAST(R.ZZFAEDN AS DATE) AS ZUCDUEDT,
    R.ZZORF_TYPE AS ZOFRTYPE,
    R.KOFIZ AS UCACTDETID,
    R.ZZKOFIZ_SD AS ZACTDETID,
    R.ZZNE_IND AS ZNEIND,
    R.VBRMONAT AS CALMONTH,
    ${helper.clean_portion("R.PORTION")} AS UCPORTION,
    -- REGEXP_REPLACE(TRIM(R.PORTION), R'[^X20-X7E]', '') AS UCPORTION,
    CAST(NULL AS STRING) AS ZUCCALEG2,
    CAST(NULL AS NUMERIC) AS ZGASLQTY,
    CAST(NULL AS STRING) AS ZGASL_UOM,
    CAST(NULL AS NUMERIC) AS ZGASQTY,
    CAST(NULL AS STRING) AS ZGAS_UOM,
    CAST(NULL AS NUMERIC) AS ZGASAMT
  FROM
    ALL_ROWS R )
SELECT
  *
FROM
  CDC_WRAPPER
