config {
  type: "incremental",
  schema: "sales_cdc_poc",
  name: "ZSEC_PURA",
  uniqueKey: ["COMP_CODE", "DOC_TYPE", "SALESEMPLY"],
  tags: ["bw_migration"]
}

-- MERGE load: key fields are COMP_CODE, DOC_TYPE, SALESEMPLY

WITH
  src_ZTSOBJ_C AS (
    SELECT
      COMP_CODE,
      SALESEMPLY,
      IMODOCCATR,
      AMNT,
      STAT_CURR,
      S4SOLD_TO,
      CUST_GRP1,
      CPR_CREATE,
      LOC_CURRCY,
      AB_ITEM,
      CRMSALORGX,
      PR_CAT_SAL,
      `0FISCYEAR`,
      `0FISCVARNT`,
      -- Calculated column: G2 AS DOC_TYPE
      'G2' AS DOC_TYPE
    FROM ${ref("ZTSOBJ_C")}
  ),
  staged_ZSEC_PURA AS (
    SELECT
      COALESCE(COMP_CODE, '')    AS COMP_CODE,
      COALESCE(SALESEMPLY, '')   AS SALESEMPLY,
      IMODOCCATR                 AS IMODOCCATR,
      AMNT                       AS AMNT,
      STAT_CURR                  AS STAT_CURR,
      S4SOLD_TO                  AS S4SOLD_TO,
      CUST_GRP1                  AS CUST_GRP1,
      CPR_CREATE                 AS CPR_CREATE,
      LOC_CURRCY                 AS LOC_CURRCY,
      AB_ITEM                    AS AB_ITEM,
      CRMSALORGX                 AS CRMSALORGX,
      PR_CAT_SAL                 AS PR_CAT_SAL,
      `0FISCYEAR`                AS `0FISCYEAR`,
      `0FISCVARNT`               AS `0FISCVARNT`,
      COALESCE(DOC_TYPE, '')     AS DOC_TYPE
    FROM src_ZTSOBJ_C
  )
SELECT
  COMP_CODE,
  SALESEMPLY,
  IMODOCCATR,
  AMNT,
  STAT_CURR,
  S4SOLD_TO,
  CUST_GRP1,
  CPR_CREATE,
  LOC_CURRCY,
  AB_ITEM,
  CRMSALORGX,
  PR_CAT_SAL,
  `0FISCYEAR`,
  `0FISCVARNT`,
  DOC_TYPE
FROM staged_ZSEC_PURA
-- INCREMENTAL NOTE: no timestamp column available for delta filter;
-- full reload on every run. Add a WHERE clause when a delta key exists.