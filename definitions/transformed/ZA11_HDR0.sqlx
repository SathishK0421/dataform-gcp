config {
  type: "incremental",
  schema: "sales_cdc_poc",
  name: "ZA11_HDR0",
  uniqueKey: ["VBELN"],
  assertions: {
    nonNull: ["VBELN"]
  },
  tags: ["bw_migration"]
}

WITH
src_2LIS_11_VAHDR AS (
  SELECT
    ROCANCEL,
    VBELN,
    BUCHK,
    AUART,
    AUGRU,
    BUKRS,
    ERDAT,
    FAKSK,
    HWAER,
    KUNNR,
    KURST,
    KVGR1,
    KVGR2,
    KVGR3,
    KVGR4,
    KVGR5,
    LIFSK,
    PVRTNR,
    STWAE,
    VBTYP,
    VDATU,
    VKBUR,
    VKGRP,
    VKORG,
    VTWEG,
    WAERK,
    AEDAT,
    AUDAT,
    AUFNR,
    AUTLF,
    BSARK,
    CMWAE,
    ERNAM,
    ERZET,
    KOKRS,
    KOSTL,
    KTEXT,
    LAND1,
    LAST_CHANGED_BY_USER,
    MANDT,
    NETWR,
    OBJNR,
    PKUNRE,
    PKUNRG,
    PKUNWE,
    SPART,
    UPD_TMSTMP,
    VSBED,
    VSNMR_V,
    SPARA,
    ANZAU,
    PERIV,
    ZZSALES_PERSON,
    ODQ_CHANGEMODE,
    ODQ_ENTITYCNTR
  FROM ${ref("2LIS_11_VAHDR_S4HCLNT100")}
),

staged_ZA11_HDR0 AS (
  SELECT
    s.ROCANCEL                              AS ROCANCEL,
    LPAD(s.VBELN, 10, '0')                 AS VBELN,
    s.BUCHK                                AS BUCHK,
    s.AUART                                AS AUART,
    s.AUGRU                                AS AUGRU,
    s.BUKRS                                AS BUKRS,
    s.ERDAT                                AS ERDAT,       -- already DATE per _date_fields
    s.FAKSK                                AS FAKSK,
    s.HWAER                                AS HWAER,       -- WAERS: STRING
    LPAD(s.KUNNR, 10, '0')                 AS KUNNR,
    s.KURST                                AS KURST,
    s.KVGR1                                AS KVGR1,
    s.KVGR2                                AS KVGR2,
    s.KVGR3                                AS KVGR3,
    s.KVGR4                                AS KVGR4,
    s.KVGR5                                AS KVGR5,
    s.LIFSK                                AS LIFSK,
    s.PVRTNR                               AS PVRTNR,
    s.STWAE                                AS STWAE,       -- WAERS: STRING
    s.VBTYP                                AS VBTYP,
    s.VDATU                                AS VDATU,       -- already DATE per _date_fields
    s.VKBUR                                AS VKBUR,
    s.VKGRP                                AS VKGRP,
    s.VKORG                                AS VKORG,
    s.VTWEG                                AS VTWEG,
    s.WAERK                                AS WAERK,       -- WAERS: STRING
    s.AEDAT                                AS AEDAT,       -- already DATE per _date_fields
    s.AUDAT                                AS AUDAT,
    LPAD(s.AUFNR, 12, '0')                 AS AUFNR,
    s.AUTLF                                AS AUTLF,
    s.BSARK                                AS BSARK,
    s.CMWAE                                AS CMWAE,
    s.ERNAM                                AS ERNAM,
    PARSE_TIME('%H%M%S', s.ERZET)          AS ERZET,       -- TIMS → TIME
    s.KOKRS                                AS KOKRS,
    s.KOSTL                                AS KOSTL,
    s.KTEXT                                AS KTEXT,
    s.LAND1                                AS LAND1,
    s.LAST_CHANGED_BY_USER                 AS LAST_CHANGED_BY_USER,
    s.MANDT                                AS MANDT,
    CAST(s.NETWR AS NUMERIC)               AS NETWR,
    s.OBJNR                                AS OBJNR,
    s.PKUNRE                               AS PKUNRE,
    s.PKUNRG                               AS PKUNRG,
    s.PKUNWE                               AS PKUNWE,
    s.SPART                                AS SPART,
    s.UPD_TMSTMP                           AS UPD_TMSTMP,
    s.VSBED                                AS VSBED,
    s.VSNMR_V                              AS VSNMR_V,
    s.SPARA                                AS SPARA,
    s.ANZAU                                AS ANZAU,
    s.PERIV                                AS PERIV,
    s.ZZSALES_PERSON                       AS ZZSALES_PERSON,
    s.ODQ_CHANGEMODE                       AS ODQ_CHANGEMODE,
    s.ODQ_ENTITYCNTR                       AS ODQ_ENTITYCNTR
  FROM src_2LIS_11_VAHDR s
)

SELECT
  ROCANCEL,
  VBELN,
  BUCHK,
  AUART,
  AUGRU,
  BUKRS,
  ERDAT,
  FAKSK,
  HWAER,
  KUNNR,
  KURST,
  KVGR1,
  KVGR2,
  KVGR3,
  KVGR4,
  KVGR5,
  LIFSK,
  PVRTNR,
  STWAE,
  VBTYP,
  VDATU,
  VKBUR,
  VKGRP,
  VKORG,
  VTWEG,
  WAERK,
  AEDAT,
  AUDAT,
  AUFNR,
  AUTLF,
  BSARK,
  CMWAE,
  ERNAM,
  ERZET,
  KOKRS,
  KOSTL,
  KTEXT,
  LAND1,
  LAST_CHANGED_BY_USER,
  MANDT,
  NETWR,
  OBJNR,
  PKUNRE,
  PKUNRG,
  PKUNWE,
  SPART,
  UPD_TMSTMP,
  VSBED,
  VSNMR_V,
  SPARA,
  ANZAU,
  PERIV,
  ZZSALES_PERSON,
  ODQ_CHANGEMODE,
  ODQ_ENTITYCNTR
FROM staged_ZA11_HDR0
${when(incremental(), `WHERE UPD_TMSTMP > (
    SELECT IFNULL(MAX(UPD_TMSTMP), TIMESTAMP('1900-01-01 00:00:00')) FROM ${self()}
)`)}