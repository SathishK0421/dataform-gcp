config {
  type: "incremental",
  schema: "sales_cdc_poc",
  name: "ZSEC_SALA",
  uniqueKey: ["COMP_CODE", "DOC_TYPE", "SALESEMPLY"],
  assertions: {
    nonNull: ["COMP_CODE", "DOC_TYPE", "SALESEMPLY"]
  },
  tags: ["bw_migration"]
}

-- MERGE load: key fields are COMP_CODE, DOC_TYPE, SALESEMPLY
-- INCREMENTAL NOTE: no timestamp column available for delta filter;
-- full reload on every run. Add a WHERE clause when a delta key exists.

WITH
src_ZTSOBJ_C AS (
  SELECT
    COMP_CODE,
    SALESEMPLY,
    IMODOCCATR,
    AMNT,
    STAT_CURR,
    S4SOLD_TO,
    CUST_GRP1,
    CPR_CREATE,
    LOC_CURRCY,
    AB_ITEM,
    CRMSALORGX,
    PR_CAT_SAL,
    -- TODO: verify `0FISCYEAR` exists in ZTSOBJ_C schema; replaced with NULL guard if absent
    NULL AS `0FISCYEAR`,
    -- TODO: verify `0FISCVARNT` exists in ZTSOBJ_C schema; replaced with NULL guard if absent
    NULL AS `0FISCVARNT`,
    AG
  FROM ${ref("ZTSOBJ_C")}
),

staged_ZSEC_SALA AS (
  SELECT
    -- TODO: confirm COMP_CODE is NUMC/CHAR; if not, remove COALESCE to avoid silent NULL masking
    COALESCE(s.COMP_CODE, '')    AS COMP_CODE,
    COALESCE(s.SALESEMPLY, '')   AS SALESEMPLY,
    s.IMODOCCATR                 AS IMODOCCATR,
    CAST(s.AMNT AS NUMERIC)      AS AMNT,
    s.STAT_CURR                  AS STAT_CURR,
    s.S4SOLD_TO                  AS S4SOLD_TO,
    s.CUST_GRP1                  AS CUST_GRP1,
    s.CPR_CREATE                 AS CPR_CREATE,
    s.LOC_CURRCY                 AS LOC_CURRCY,
    s.AB_ITEM                    AS AB_ITEM,
    s.CRMSALORGX                 AS CRMSALORGX,
    s.PR_CAT_SAL                 AS PR_CAT_SAL,
    s.`0FISCYEAR`                AS `0FISCYEAR`,
    s.`0FISCVARNT`               AS `0FISCVARNT`,
    s.AG                         AS DOC_TYPE
  FROM src_ZTSOBJ_C s
)

SELECT
  COMP_CODE,
  SALESEMPLY,
  IMODOCCATR,
  AMNT,
  STAT_CURR,
  S4SOLD_TO,
  CUST_GRP1,
  CPR_CREATE,
  LOC_CURRCY,
  AB_ITEM,
  CRMSALORGX,
  PR_CAT_SAL,
  `0FISCYEAR`,
  `0FISCVARNT`,
  DOC_TYPE
FROM staged_ZSEC_SALA