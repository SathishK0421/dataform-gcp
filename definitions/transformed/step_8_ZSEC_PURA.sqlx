-- ============================================================
-- Dataform SQLX
-- Step 8 | Transformation ID: 0BALRH3OIMB52SL1VSYOG6XBCCA51HW9
-- Operation  : Merge
-- Source     : ZTSOBJ_C
-- Target     : ZSEC_PURA
-- Merge keys : COMP_CODE, SALESEMPLY
-- Calculated : 'G2' AS DOC_TYPE (hardcoded literal)
-- ============================================================

config {
  type: "incremental",
  schema: "your_dataset",
  name: "ZSEC_PURA",
  description: "Step 8 – Merge ZTSOBJ_C into ZSEC_PURA with DOC_TYPE forced to G2",
  tags: ["ZPC_TSOBJC", "step_8", "merge"],
  uniqueKey: ["COMP_CODE", "SALESEMPLY"]
}

SELECT
    COMP_CODE,
    SALESEMPLY,
    IMODOCCATR,
    AMNT,
    STAT_CURR,
    S4SOLD_TO,
    CUST_GRP1,
    CPR_CREATE,
    LOC_CURRCY,
    AB_ITEM,
    CRMSALORGX,
    PR_CAT_SAL,
    `0FISCYEAR`,
    `0FISCVARNT`,
    'G2' AS DOC_TYPE    -- Calculated column: hardcoded literal

FROM ${ref("ZTSOBJ_C")}

${ when(incremental(),
    `WHERE COMP_CODE || SALESEMPLY NOT IN (
        SELECT COMP_CODE || SALESEMPLY
        FROM ${self()}
    )`
) }
