-- ============================================================
-- Dataform SQLX
-- Step 12 | Transformation ID: 0ANX2OGX2JK0V2V6RF6MR2CQC2AV667E
-- Operation  : FullLoad
-- Source     : ZNS_ITEM
-- Target     : ZSA_ITM
-- Merge key  : VBELN -> IMODOCCATR
-- Calculated :
--   1. 0FISCVARNT = PERIV (source & target same, no logic)
--   2. LOOKUP FISCPER using FISCVARNT, PERIV between DATEFROM and DATETO AS 0FISCYEAR
--   3. START ROUTINE: filter MATNR != 'TG11'
--   4. END ROUTINE  : replace PLANT '1710' -> '1720'
--   5. (blank) AS NETVALUE — no source mapping
-- ============================================================

config {
  type: "table",
  schema: "your_dataset",
  name: "ZSA_ITM",
  description: "Step 12 – Full load ZNS_ITEM to ZSA_ITM with fiscal year lookup and PLANT remap",
  tags: ["ZPC_TSOBJC", "step_12", "full_load", "start_routine", "end_routine"]
}

WITH

-- START ROUTINE: exclude dummy material
src_filtered AS (
    SELECT *
    FROM ${ref("ZNS_ITEM")}
    WHERE MATNR <> 'TG11'   -- mirrors: DELETE &SP& WHERE MATNR EQ 'TG11'
),

-- Column mapping + fiscal year lookup
mapped AS (
    SELECT
        s.VBELN                         AS IMODOCCATR,
        s.VOLEH                         AS VOLUMEUNIT,
        s.VOLUM                         AS VOLUME,
        s.VDATU                         AS UPD_DATE,
        s.MEINS                         AS BASE_UOM,
        s.KZWI1                         AS SUBTOT_OC1,
        s.KZWI3                         AS SUBTOT_OC3,
        s.KZWI2                         AS SUBTOT_OC2,
        s.KPEIN                         AS COND_PR_UN,
        s.MWSBP                         AS TAX_VALUE,
        s.KMEIN                         AS UNIT,
        s.MATWA                         AS MATENTERD,
        s.PKUNRG                        AS PAYER,
        s.PSTYV                         AS ITM_CAT,
        s.WAERK                         AS DOC_CURRCY,
        s.PKUNWE                        AS S4SHIP_TO,
        s.BUKRS                         AS COMP_CODE,
        s.MATKL                         AS MATL_GROUP,
        s.NETPR                         AS NETPRICE,
        s.HWAER                         AS LOC_CURRCY,
        s.NTGEW                         AS NET_WGT_DL,
        s.GEWEI                         AS UNIT_OF_WT,
        s.UVFAK                         AS AB_ITEM,
        s.UVVLK                         AS DELIV_ITEM,
        s.MATNR                         AS BIC_ZMATEIAL1,
        s.STWAE                         AS STAT_CURR,
        s.ERZET                         AS TIME,
        s.ERDAT                         AS CR_ON_I,
        s.LSMENG                        AS REQDEKIQUANTY,
        s.WERKS                         AS PLANT,
        s.MATNR                         AS BASIC_MATL,
        s.WERKS                         AS PLANTCAT,
        -- 0FISCVARNT: source & target field same, no logic required
        s.PERIV                         AS `0FISCVARNT`,
        -- LOOKUP: fiscal year from calendar table using PERIV
        fy.FISCYEAR                     AS `0FISCYEAR`,
        -- NETVALUE: no source field mapping defined
        NULL                            AS NETVALUE

    FROM src_filtered AS s
    LEFT JOIN ${ref("FISCPER_CALENDAR")} AS fy   -- replace with your actual fiscal calendar ref
        ON  fy.FISCVARNT = s.PERIV
        AND s.VDATU BETWEEN fy.DATEFROM AND fy.DATETO
)

-- END ROUTINE: remap PLANT value
SELECT
    IMODOCCATR,
    VOLUMEUNIT,
    VOLUME,
    UPD_DATE,
    BASE_UOM,
    SUBTOT_OC1,
    SUBTOT_OC3,
    SUBTOT_OC2,
    COND_PR_UN,
    TAX_VALUE,
    UNIT,
    MATENTERD,
    PAYER,
    ITM_CAT,
    DOC_CURRCY,
    S4SHIP_TO,
    COMP_CODE,
    MATL_GROUP,
    NETPRICE,
    LOC_CURRCY,
    NET_WGT_DL,
    UNIT_OF_WT,
    AB_ITEM,
    DELIV_ITEM,
    BIC_ZMATEIAL1,
    STAT_CURR,
    TIME,
    CR_ON_I,
    REQDEKIQUANTY,
    CASE
        WHEN PLANT = '1710' THEN '1720'   -- mirrors ABAP end routine
        ELSE PLANT
    END AS PLANT,
    BASIC_MATL,
    PLANTCAT,
    `0FISCVARNT`,
    `0FISCYEAR`,
    NETVALUE

FROM mapped
