config {
  type: "incremental",
  schema: "sales_cdc_poc",
  name: "ZSA_ITM",
  tags: ["bw_migration"]
}

-- FullLoad: full table replacement on every Dataform run.

WITH

src_ZNS_ITEM AS (
  -- Raw read only — no mapping, no aliases, no type conversions
  SELECT
    VBELN,
    VOLEH,
    VOLUM,
    VDATU,
    MEINS,
    KZWI1,
    KZWI3,
    KZWI2,
    KPEIN,
    MWSBP,
    KMEIN,
    MATWA,
    PKUNRG,
    PSTYV,
    WAERK,
    PKUNWE,
    BUKRS,
    MATKL,
    NETPR,
    HWAER,
    NTGEW,
    GEWEI,
    UVFAK,
    UVVLK,
    MATNR,
    STWAE,
    ERZET,
    ERDAT,
    LSMENG,
    WERKS
  FROM ${ref("ZNS_ITEM")}
),

-- START ROUTINE: DELETE rows WHERE MATNR = 'TG11'
-- Translated from ABAP: DELETE &SP& WHERE MATNR EQ 'TG11'.
start_routine_ZNS_ITEM AS (
  SELECT
    VBELN,
    VOLEH,
    VOLUM,
    VDATU,
    MEINS,
    KZWI1,
    KZWI3,
    KZWI2,
    KPEIN,
    MWSBP,
    KMEIN,
    MATWA,
    PKUNRG,
    PSTYV,
    WAERK,
    PKUNWE,
    BUKRS,
    MATKL,
    NETPR,
    HWAER,
    NTGEW,
    GEWEI,
    UVFAK,
    UVVLK,
    MATNR,
    STWAE,
    ERZET,
    ERDAT,
    LSMENG,
    WERKS
  FROM src_ZNS_ITEM
  WHERE MATNR <> 'TG11'
),

-- LOOKUP: replace fiscper_stub with ${ref("REAL_TABLE_NAME")}
--         once the fiscal-period calendar table name is confirmed.
fiscper_stub AS (
  SELECT
    CAST(NULL AS STRING) AS FISCVARNT,
    CAST(NULL AS DATE)   AS DATEFROM,
    CAST(NULL AS DATE)   AS DATETO,
    CAST(NULL AS STRING) AS `0FISCPER`,
    CAST(NULL AS STRING) AS `0FISCYEAR`
  WHERE FALSE
),

staged_ZSA_ITM AS (
  -- All field mapping, type casts, and aliases applied here
  -- _date_fields: ERDAT, ERZET, VDATU are already DATE — no PARSE_DATE
  -- _numc_fields: MATNR, VBELN remain STRING — no INT cast
  -- _waers_fields: HWAER, STWAE, WAERK remain STRING — no numeric cast
  SELECT
    -- FISCVARNT join: no fiscal variant field present in source — returning NULLs from stub
    -- LOOKUP: fiscper_stub returns NULL for 0FISCPER / 0FISCYEAR until real table is wired in
    s.VBELN                                   AS IMODOCCATR,
    s.VOLEH                                   AS VOLUMEUNIT,
    CAST(s.VOLUM AS NUMERIC(18,3))            AS VOLUME,
    PARSE_DATE('%Y%m%d', s.VDATU)            AS UPD_DATE,
    s.MEINS                                   AS BASE_UOM,
    CAST(s.KZWI1 AS NUMERIC)                 AS SUBTOT_OC1,
    CAST(s.KZWI3 AS NUMERIC)                 AS SUBTOT_OC3,
    CAST(s.KZWI2 AS NUMERIC)                 AS SUBTOT_OC2,
    CAST(s.KPEIN AS NUMERIC)                 AS COND_PR_UN,
    CAST(s.MWSBP AS NUMERIC)                 AS TAX_VALUE,
    s.KMEIN                                   AS UNIT,
    s.MATWA                                   AS MATENTERD,
    s.PKUNRG                                  AS PAYER,
    s.PSTYV                                   AS ITM_CAT,
    s.WAERK                                   AS DOC_CURRCY,
    s.PKUNWE                                  AS S4SHIP_TO,
    s.BUKRS                                   AS COMP_CODE,
    s.MATKL                                   AS MATL_GROUP,
    CAST(s.NETPR AS NUMERIC)                 AS NETPRICE,
    s.HWAER                                   AS LOC_CURRCY,
    CAST(s.NTGEW AS NUMERIC)                 AS NET_WGT_DL,
    s.GEWEI                                   AS UNIT_OF_WT,
    s.UVFAK                                   AS AB_ITEM,
    s.UVVLK                                   AS DELIV_ITEM,
    s.MATNR                                   AS BIC_ZMATEIAL1,
    s.STWAE                                   AS STAT_CURR,
    PARSE_TIME('%H%M%S', s.ERZET)            AS ERZET_TIME,
    PARSE_DATE('%Y%m%d', s.ERDAT)            AS CR_ON_I,
    CAST(s.LSMENG AS NUMERIC)                AS REQDEKIQUANTY,
    s.WERKS                                   AS PLANT,
    s.MATNR                                   AS BASIC_MATL,
    s.WERKS                                   AS PLANTCAT,
    -- Calculated columns from spec:
    -- "SOURCE & TARGET FIELD SAME, NO LOGIC REQUIRED AS 0FISCVARNT" → pass-through STRING
    s.STWAE                                   AS `0FISCVARNT`,
    -- LOOKUP: 0FISCYEAR via fiscper_stub (no fiscal variant field available; returns NULL)
    fp.`0FISCYEAR`                            AS `0FISCYEAR`,
    -- LOOKUP: 0FISCPER via fiscper_stub (no fiscal variant field available; returns NULL)
    fp.`0FISCPER`                             AS `0FISCPER`,
    -- NETVALUE: no source expression defined in Calculated_Column spec
    NULL                                      AS NETVALUE
  FROM start_routine_ZNS_ITEM s
  LEFT JOIN fiscper_stub fp
    -- NOTE: No fiscal variant field available in source — join is on NULL stub only
    ON FALSE
),

-- END ROUTINE: if plant = '1710' then plant = '1720'
-- Translated from ABAP:
--   loop at &RP& assigning <result_fields>.
--   if <result_fields>-plant = '1710'.
--     <result_fields>-plant = '1720'.
--   endif.
--   endloop.
end_routine_ZSA_ITM AS (
  SELECT
    IMODOCCATR,
    VOLUMEUNIT,
    VOLUME,
    UPD_DATE,
    BASE_UOM,
    SUBTOT_OC1,
    SUBTOT_OC3,
    SUBTOT_OC2,
    COND_PR_UN,
    TAX_VALUE,
    UNIT,
    MATENTERD,
    PAYER,
    ITM_CAT,
    DOC_CURRCY,
    S4SHIP_TO,
    COMP_CODE,
    MATL_GROUP,
    NETPRICE,
    LOC_CURRCY,
    NET_WGT_DL,
    UNIT_OF_WT,
    AB_ITEM,
    DELIV_ITEM,
    BIC_ZMATEIAL1,
    STAT_CURR,
    ERZET_TIME,
    CR_ON_I,
    REQDEKIQUANTY,
    -- END ROUTINE: remap PLANT '1710' → '1720'
    CASE WHEN PLANT = '1710' THEN '1720' ELSE PLANT END AS PLANT,
    BASIC_MATL,
    PLANTCAT,
    `0FISCVARNT`,
    `0FISCYEAR`,
    `0FISCPER`,
    NETVALUE
  FROM staged_ZSA_ITM
)

SELECT
  IMODOCCATR,
  VOLUMEUNIT,
  VOLUME,
  UPD_DATE,
  BASE_UOM,
  SUBTOT_OC1,
  SUBTOT_OC3,
  SUBTOT_OC2,
  COND_PR_UN,
  TAX_VALUE,
  UNIT,
  MATENTERD,
  PAYER,
  ITM_CAT,
  DOC_CURRCY,
  S4SHIP_TO,
  COMP_CODE,
  MATL_GROUP,
  NETPRICE,
  LOC_CURRCY,
  NET_WGT_DL,
  UNIT_OF_WT,
  AB_ITEM,
  DELIV_ITEM,
  BIC_ZMATEIAL1,
  STAT_CURR,
  TIME,
  CR_ON_I,
  REQDEKIQUANTY,
  PLANT,
  BASIC_MATL,
  PLANTCAT,
  `0FISCVARNT`,
  `0FISCYEAR`,
  `0FISCPER`,
  NETVALUE
FROM end_routine_ZSA_ITM