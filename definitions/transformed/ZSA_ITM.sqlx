config {
  type: "incremental",
  schema: "sales_cdc_poc",
  name: "ZSA_ITM",
  tags: ["bw_migration"]
}

-- FullLoad: full table replacement on every Dataform run.

WITH
  src_zns_item AS (
    SELECT
      VBELN,
      VOLEH,
      VOLUM,
      VDATU,
      MEINS,
      NETWR,
      PERIV,
      KZWI1,
      KZWI2,
      KZWI3,
      KMEIN,
      MATWA,
      KPEIN,
      MWSBP,
      PKUNRG,
      PSTYV,
      PKUNWE,
      WAERK,
      NETPR,
      HWAER,
      NTGEW,
      GEWEI,
      UVFAK,
      UVVLK,
      BUKRS,
      MATKL,
      ERZET,
      ERDAT,
      MATNR,
      STWAE,
      LSMENG,
      WERKS
    FROM ${ref("ZNS_ITEM")}
  ),

  -- LOOKUP: join FISCPER lookup table to resolve 0FISCYEAR from PERIV and date range
  fiscper_lookup AS (
    -- LOOKUP: verify table name before deploying
    SELECT
      CAST(NULL AS STRING) AS FISCVARNT,
      CAST(NULL AS STRING) AS PERIV,
      CAST(NULL AS DATE)   AS DATEFROM,
      CAST(NULL AS DATE)   AS DATETO,
      CAST(NULL AS STRING) AS `0FISCYEAR`
  ),

  staged_zns_item AS (
    SELECT
      s.VBELN,
      s.VOLEH,
      s.VOLUM,
      s.VDATU,
      s.MEINS,
      s.NETWR,
      s.PERIV,
      CAST(s.KZWI1 AS NUMERIC)              AS KZWI1,
      CAST(s.KZWI2 AS NUMERIC)              AS KZWI2,
      CAST(s.KZWI3 AS NUMERIC)              AS KZWI3,
      s.KMEIN,
      s.MATWA,
      s.KPEIN,
      CAST(s.MWSBP AS NUMERIC)              AS MWSBP,
      s.PKUNRG,
      s.PSTYV,
      s.PKUNWE,
      s.WAERK,
      CAST(s.NETPR AS NUMERIC)              AS NETPR,
      s.HWAER,
      s.NTGEW,
      s.GEWEI,
      s.UVFAK,
      s.UVVLK,
      s.BUKRS,
      s.MATKL,
      s.ERZET,
      s.ERDAT,
      s.MATNR,
      s.STWAE,
      s.LSMENG,
      s.WERKS,
      -- Calculated: NETWR * 10 AS NETVALUE
      CAST(s.NETWR AS NUMERIC) * 10         AS calc_NETVALUE,
      -- Calculated: LOOKUP TABLE FISCPER using FISCVARNT, PERIV between DATEFROM and DATETO AS 0FISCYEAR
      fl.`0FISCYEAR`                        AS calc_0FISCYEAR,
      -- Calculated: SOURCE & TARGET FIELD SAME, NO LOGIC REQUIRED AS 0FISCVARNT
      fl.FISCVARNT                          AS calc_0FISCVARNT
    FROM src_zns_item s
    LEFT JOIN fiscper_lookup fl
      ON fl.PERIV = s.PERIV
      AND s.VDATU BETWEEN fl.DATEFROM AND fl.DATETO
  ),

  mapped_zsa_itm AS (
    SELECT
      VBELN                             AS IMODOCCATR,
      VOLEH                             AS VOLUMEUNIT,
      VOLUM                             AS VOLUME,
      PARSE_DATE('%Y%m%d', VDATU)       AS UPD_DATE,
      MEINS                             AS BASE_UOM,
      calc_NETVALUE                     AS NETVALUE,
      calc_0FISCYEAR                    AS `0FISCYEAR`,
      KZWI1                             AS SUBTOT_OC1,
      KZWI2                             AS SUBTOT_OC2,
      KZWI3                             AS SUBTOT_OC3,
      KMEIN                             AS UNIT,
      MATWA                             AS MATENTERD,
      KPEIN                             AS COND_PR_UN,
      MWSBP                             AS TAX_VALUE,
      PKUNRG                            AS PAYER,
      PSTYV                             AS ITM_CAT,
      PKUNWE                            AS S4SHIP_TO,
      WAERK                             AS DOC_CURRCY,
      NETPR                             AS NETPRICE,
      HWAER                             AS LOC_CURRCY,
      NTGEW                             AS NET_WGT_DL,
      GEWEI                             AS UNIT_OF_WT,
      UVFAK                             AS AB_ITEM,
      UVVLK                             AS DELIV_ITEM,
      BUKRS                             AS COMP_CODE,
      MATKL                             AS MATL_GROUP,
      ERZET                             AS TIME,
      PARSE_DATE('%Y%m%d', ERDAT)       AS CR_ON_I,
      MATNR                             AS BASIC_MATL,
      STWAE                             AS STAT_CURR,
      calc_0FISCVARNT                   AS `0FISCVARNT`,
      LSMENG                            AS REQDEKIQUANTY,
      -- PLANTCAT: second mapping of WERKS to PLANTCAT
      WERKS                             AS PLANTCAT,
      WERKS                             AS PLANT,
      NULL                              AS nan -- no source mapping defined
    FROM staged_zns_item
  )

SELECT
  IMODOCCATR,
  VOLUMEUNIT,
  VOLUME,
  UPD_DATE,
  BASE_UOM,
  NETVALUE,
  `0FISCYEAR`,
  SUBTOT_OC1,
  SUBTOT_OC2,
  SUBTOT_OC3,
  UNIT,
  MATENTERD,
  COND_PR_UN,
  TAX_VALUE,
  PAYER,
  ITM_CAT,
  S4SHIP_TO,
  DOC_CURRCY,
  NETPRICE,
  LOC_CURRCY,
  NET_WGT_DL,
  UNIT_OF_WT,
  AB_ITEM,
  DELIV_ITEM,
  COMP_CODE,
  MATL_GROUP,
  TIME,
  CR_ON_I,
  ZMATEIAL1,
  STAT_CURR,
  `0FISCVARNT`,
  REQDEKIQUANTY,
  BASIC_MATL,
  PLANTCAT,
  PLANT,
  nan
FROM mapped_zsa_itm